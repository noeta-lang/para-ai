// Asking a model one question with `para.ai` — the whole phase-1 surface in one file.
//
// Two things this example exists to show:
//
//   * **Runtime provider selection is the caller's `match`.** `Provider` is a bound, never a trait
//     object, so `Agent<Anthropic>` and `Agent<Mock>` are different types and no single binding can
//     hold either. That is not a workaround to hide — it is the pattern, and it works because
//     `run_sync` returns a provider-independent `Result<string, AiError>`, so the arms diverge at
//     construction and re-converge at the result. One line per provider, not a duplicated program.
//   * **The `@test` block at the bottom is the point of the file as much as the code above it.**
//     Every assertion runs against a scripted `Mock` — both the codec and the transport — so the
//     suite is hermetic, needs no API key, and cannot fail because a vendor is slow.
//
//     ANTHROPIC_API_KEY=sk-... noeta run  examples/ask/main.noe    # a real call
//     noeta run  main.noe                                          # no key: answers from the mock
//     noeta test main.noe                                          # the assertions
namespace noeta.ask

use std.{env, io}
use para.ai.{Agent, AgentConfig, AiError, Conversation, Message, Part, Role, Run}
use para.ai.mock.Mock
use para.ai.provider.StopReason
use para.ai.providers.anthropic.Anthropic

// The agent's configuration is a plain value — no provider, no transport. This is the `Send` half:
// the thing you would hand to a worker or an isolate, which then builds its own `Agent` from it.
fn config(): AgentConfig {
    return AgentConfig.new("claude-opus-5")
        .with_system("You are terse. Answer in one short sentence.")
        .with_max_tokens(256)
        .named("ask")
}

// The scripted stand-in used when no API key is set — and by every test below.
fn offline(): Mock {
    return Mock.new().reply_text("Hej! Trevligt att träffas.")
}

// The runtime-selection `match`, pushed to the outermost point where the arms still agree.
fn ask(text: string): Result<string, AiError> {
    which = env.get("AI_PROVIDER") ?? (if env.get("ANTHROPIC_API_KEY") == none then "mock" else "anthropic")
    return match which {
        "mock" => offline().agent(config()).run_sync(text),
        _ => Agent.from(config(), Anthropic.from_env() ?? Anthropic.new("")).run_sync(text),
    }
}

// A run gives back more than the answer: the whole conversation, the aggregate token usage, how
// many model calls it took, and why the model stopped.
async fn ask_verbose(text: string): Result<string, AiError> {
    m = offline()
    run = m.agent(config()).run(Conversation.of(text)).await?
    return Ok("${run.text()} [${run.turns} turn, ${run.usage.input_tokens}+${run.usage.output_tokens} tokens, ${run.stop}]")
}

// `noeta test` never runs top-level statements, so these two lines are the entry point only.
io.outln(match ask("Say hello in Swedish.") {
    Ok(answer) => answer,
    Err(e) => "error: ${e}",
})
io.outln(match ask_verbose("Say hello in Swedish.").await {
    Ok(answer) => answer,
    Err(e) => "error: ${e}",
})

@test {
    // The string-in / string-out door, end to end: encode, send through the chain, decode. The
    // mock is both the codec and the transport, so nothing about the run is skipped and nothing
    // about it touches a socket.
    fn a_scripted_answer_comes_back(): void {
        m = offline()
        assert(m.agent(config()).run_sync("Say hello in Swedish.") == Ok("Hej! Trevligt att träffas."))
        assert(m.call_count() == 1)
    }

    // Asserting on *what was sent* is the difference between "the agent replied" and "the agent
    // asked the right question".
    fn the_request_carries_the_configured_system_prompt_and_budget(): void {
        m = offline()
        one = m.agent(config()).run_sync("Say hello in Swedish.")
        sent = m.calls()[0]
        assert(sent.contains("\"model\":\"claude-opus-5\""), sent)
        assert(sent.contains("\"max_tokens\":256"), sent)
        assert(sent.contains("You are terse."), sent)
    }

    async fn a_run_reports_its_usage_and_stop_reason(): void {
        run = match offline().agent(config()).run(Conversation.of("hi")).await {
            Ok(r) => r,
            Err(e) => Run { messages: [Message.assistant("FAILED: ${e}")] },
        }
        assert(run.turns == 1)
        assert(run.stop == StopReason.EndTurn)
        assert(run.usage.total() > 0)
        // The conversation comes back whole, so it can be fed straight into the next turn.
        assert(run.messages.len() == 2)
        assert(run.conversation().user("and again").messages.len() == 3)
    }

    // A vendor error status is an answer with a typed body, not a transport failure — so `code` is
    // matchable and nobody has to regex a message string.
    fn a_rate_limit_is_a_typed_error(): void {
        m = Mock.new().fail(429, "rate_limit_error", "slow down")
        match m.agent(config()).run_sync("hi") {
            Ok(_) => {
                assert(false, "a 429 is not an answer")
            },
            Err(e) => {
                assert(match e {
                    AiError.Provider(status, code, message) => status == 429 && code == "rate_limit_error",
                    _ => false,
                }, "${e}")
            },
        }
    }

    // A refusal is its own error. Conflating it with a decode failure makes "the model declined"
    // look like "your request was malformed", which sends people debugging the wrong thing.
    fn a_refusal_is_not_a_decode_failure(): void {
        m = Mock.new().refuse("I can't help with that.")
        match m.agent(config()).run_sync("...") {
            Ok(_) => {
                assert(false, "a refusal is not an answer")
            },
            Err(e) => {
                assert(match e { AiError.Refused(reason) => true, _ => false }, "${e}")
            },
        }
    }

    // The Anthropic codec is pure, so it is testable with no agent, no transport, and no key.
    fn the_anthropic_codec_encodes_this_config_like_so(): void {
        req = Agent.from(config(), Anthropic.new("sk-test")).request(Conversation.of("Say hello in Swedish."))
        match Anthropic.new("sk-test").encode(req) {
            Ok(w) => {
                assert(w.url == "https://api.anthropic.com/v1/messages")
                assert(w.headers["x-api-key"] == "sk-test")
                // The system prompt is hoisted to a top-level field — Anthropic rejects a
                // `"role": "system"` entry in `messages` — and it carries a `cache_control`
                // marker, because a system prompt that interpolates nothing is stable in its
                // entirety and para/ai marks the longest stable prefix by default.
                // `examples/prompt-cache` is what that looks like when a prompt has a volatile
                // tail; `AgentConfig.uncached()` is how to turn it off.
                assert(w.body.contains("\"system\":[{\"cache_control\":{\"type\":\"ephemeral\"},\"text\":\"You are terse. Answer in one short sentence.\",\"type\":\"text\"}]"), w.body)
                assert(!w.body.contains("\"role\":\"system\""), w.body)
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }
}
