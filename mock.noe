// `para.ai.mock` — the hermetic test double.
//
//     m = Mock.new().reply_text("18°C and clear in Malmö.")
//     agent = m.agent(AgentConfig.new("test-model"))
//     assert(agent.run_sync("What's the weather in Malmö?")?.contains("18°C"))
//     assert(m.calls().len() == 1)
//
// `Mock` is **not a special case in the framework** — it is an ordinary `Provider` whose `encode`
// ignores what the request says and whose `decode_reply` reads back a scripted answer. It is also a
// `para.api.Middleware`, which is what closes the loop: the run loop still encodes, still sends
// through the chain, still decodes, and the layer that would have opened a socket answers from the
// script instead. Nothing about the run is bypassed and nothing about it touches the network.
//
// Because it is both halves, `calls()` records **the bytes the codec actually produced** rather
// than a re-derivation of them — which is what makes "assert on what was sent" mean something.
//
// It is a `class` and every other type in this package is a value: a recorder accumulates across
// calls, so it needs reference identity and mutable state — exactly the reason `para/api`'s
// `Record` is one. That makes a `Mock`-backed agent `!Send`, which is fine: a test is not an
// isolate.
namespace para.ai.mock

use std.http.client
use std.http.server
use std.http.{HttpError, Request, Response}
use std.json
use para.api.{Api, Middleware, Next}
use para.ai.{Agent, AgentConfig, AiError, Conversation, Message, Part, Role}
use para.ai.provider
use para.ai.provider.{Delta, ModelReply, ModelRequest, Provider, StopReason, Usage, Wire}
use para.ai.tools.{Arg, Local, Tool, ToolSource}

// One tool call in a scripted turn. `args` is a raw JSON blob, exactly as a vendor would stream
// one, so a test can script a malformed blob and watch the dispatcher refuse it.
@derive(Equatable, Display)
pub struct ScriptedCall {
    pub id: string
    pub name: string
    pub args: string = "{}"
}

// One scripted answer. The script is consumed in order, one entry per model call.
@derive(Equatable, Display)
pub enum Scripted {
    // A plain assistant answer; the run finishes.
    Text(text: string)
    // The model asks for one or more tools **in a single turn**. A list rather than a single call
    // because parallel tool use is the interesting case: it is what every current vendor emits, and
    // a run that dispatches two calls at once is the only one that exercises the concurrency bound.
    Tools(calls: List<ScriptedCall>)
    // The model declines — surfaces as `AiError.Refused`, never as a decode failure.
    Refusal(reason: string)
    // The vendor answers with an error status — surfaces as `AiError.Provider`.
    Failure(status: int, code: string, message: string)
}

// The neutral JSON this codec speaks. It is `Mock`'s own wire format, so it can be whatever is
// most readable in a failing assertion — a faithful, flat rendering of the parts.

fn part_to_json(p: Part): Map<string, dyn> {
    return match p {
        Part.Text(text) => {"type": "text", "text": text},
        Part.Thinking(text, signature) => {"type": "thinking", "text": text, "signature": signature},
        Part.ToolCall(id, name, args) => {"type": "tool_call", "id": id, "name": name, "args": args},
        Part.ToolResult(id, content, is_error) => {"type": "tool_result", "id": id, "content": content, "is_error": is_error},
        // The bytes themselves are noise in an assertion; their length is the part that varies.
        Part.Image(mime, data) => {"type": "image", "mime": mime, "bytes": data.len()},
        Part.File(mime, name, data) => {"type": "file", "mime": mime, "name": name, "bytes": data.len()},
    }
}

fn part_from_json(o: Map<string, dyn>): Result<Part, AiError> {
    kind = provider.str_at(o, "type")
    if kind == "text" {
        return Ok(Part.Text(text: provider.str_at(o, "text")))
    }
    if kind == "thinking" {
        return Ok(Part.Thinking(text: provider.str_at(o, "text"), signature: provider.str_at(o, "signature")))
    }
    if kind == "tool_call" {
        return Ok(Part.ToolCall(
            id: provider.str_at(o, "id"),
            name: provider.str_at(o, "name"),
            args: provider.str_at(o, "args"),
        ))
    }
    return Err(AiError.Decode(path: "parts[].type", message: "mock cannot decode a `${kind}` part"))
}

fn role_name(r: Role): string {
    return match r {
        Role.System => "system",
        Role.User => "user",
        Role.Assistant => "assistant",
        Role.Tool => "tool",
    }
}

fn message_to_json(m: Message): Map<string, dyn> {
    mut parts: List<dyn> = []
    for p in m.parts {
        parts = parts ~ [part_to_json(p)]
    }
    out: Map<string, dyn> = {"role": role_name(m.role), "parts": parts}
    return out
}

fn stop_name(s: StopReason): string {
    return match s {
        StopReason.EndTurn => "end_turn",
        StopReason.ToolUse => "tool_use",
        StopReason.MaxTokens => "max_tokens",
        StopReason.StopSequence => "stop_sequence",
        StopReason.Refusal => "refusal",
        StopReason.Other(raw) => raw,
    }
}

fn stop_from_name(raw: string): StopReason {
    return match raw {
        "end_turn" => StopReason.EndTurn,
        "tool_use" => StopReason.ToolUse,
        "max_tokens" => StopReason.MaxTokens,
        "stop_sequence" => StopReason.StopSequence,
        "refusal" => StopReason.Refusal,
        _ => StopReason.Other(raw: raw),
    }
}

fn one_part(m: Map<string, dyn>): List<dyn> {
    out: List<dyn> = [m]
    return out
}

fn call_parts(calls: List<ScriptedCall>): List<dyn> {
    mut out: List<dyn> = []
    for c in calls {
        out = out ~ [part_to_json(Part.ToolCall(id: c.id, name: c.name, args: c.args))]
    }
    return out
}

fn scripted_parts(s: Scripted): List<dyn> {
    return match s {
        Scripted.Text(text) => one_part(part_to_json(Part.Text(text: text))),
        Scripted.Tools(calls) => call_parts(calls),
        Scripted.Refusal(reason) => one_part(part_to_json(Part.Text(text: reason))),
        // Never reached: a failure is an error status, which the run loop routes to `decode_error`
        // before `decode_reply` is consulted.
        Scripted.Failure(status, code, message) => [],
    }
}

fn scripted_stop(s: Scripted): StopReason {
    return match s {
        Scripted.Text(text) => StopReason.EndTurn,
        Scripted.Tools(calls) => StopReason.ToolUse,
        Scripted.Refusal(reason) => StopReason.Refusal,
        Scripted.Failure(status, code, message) => StopReason.EndTurn,
    }
}

// A scripted entry as the reply body this codec reads back. Usage is synthesized from the sizes
// involved so a telemetry assertion has something deterministic and non-zero to look at.
fn reply_body(s: Scripted, input_tokens: int): string {
    parts = scripted_parts(s)
    usage: Map<string, dyn> = {
        "input_tokens": input_tokens,
        "output_tokens": json.stringify(parts).len() / 4,
    }
    body: Map<string, dyn> = {
        "model": "mock",
        "stop": stop_name(scripted_stop(s)),
        "parts": parts,
        "usage": usage,
    }
    return json.stringify(body)
}

// The scripted `Provider` and the transport layer that answers it, in one object.
pub class Mock {
    mut script: List<Scripted>
    mut cursor: int
    mut sent: List<string>

    fn new(): Mock {
        return Mock { script: [], cursor: 0, sent: [] }
    }

    // --- Scripting ---------------------------------------------------------------------------
    //
    // Each of these appends one answer and returns the same `Mock`, so a multi-turn script reads
    // top to bottom in the order the model would produce it.

    fn reply_text(text: string): Mock {
        self.script = self.script ~ [Scripted.Text(text: text)]
        return self
    }

    // One tool call in a turn.
    fn reply_tool(id: string, name: string, args: string): Mock {
        self.script = self.script ~ [Scripted.Tools(calls: [ScriptedCall { id: id, name: name, args: args }])]
        return self
    }

    // Several tool calls in **one** turn — the parallel case, and the one that exercises
    // `AgentConfig.tool_concurrency`.
    fn reply_tools(calls: List<ScriptedCall>): Mock {
        self.script = self.script ~ [Scripted.Tools(calls: calls)]
        return self
    }

    fn refuse(reason: string): Mock {
        self.script = self.script ~ [Scripted.Refusal(reason: reason)]
        return self
    }

    fn fail(status: int, code: string, message: string): Mock {
        self.script = self.script ~ [Scripted.Failure(status: status, code: code, message: message)]
        return self
    }

    // --- Introspection -----------------------------------------------------------------------

    // Every request body the codec produced, in order — the answer to "what did the agent actually
    // send?". Worth asserting on: it is the difference between "the agent replied" and "the agent
    // asked the right question".
    fn calls(): List<string> {
        return self.sent
    }

    // How many model calls the agent made.
    fn call_count(): int {
        return self.sent.len()
    }

    // How many scripted answers are still unused. A test that ends with this above zero scripted
    // more turns than the run took.
    fn remaining(): int {
        return self.script.len() - self.cursor
    }

    // --- Wiring ------------------------------------------------------------------------------

    // A transport chain whose only layer is this mock. Nothing below it exists, so no socket can
    // be opened even by accident.
    fn api(): Api {
        return Api.new(client.new()).with(self)
    }

    // The whole hermetic setup in one call: an agent whose codec **and** transport are this mock.
    fn agent(cfg: AgentConfig): Agent<Mock> {
        return Agent.over(cfg, self, self.api())
    }

    // The same, with a source of tools attached — the full tool loop with no socket in it.
    // `Result` because attaching a source derives every schema and checks every name.
    fn tool_agent(cfg: AgentConfig, src: dyn ToolSource): Result<Agent<Mock>, AiError> {
        return self.agent(cfg).tools(src)
    }
}

impl Provider for Mock {
    fn name(): string {
        return "mock"
    }

    fn encode(req: ModelRequest): Result<Wire, AiError> {
        mut msgs: List<dyn> = []
        for m in req.messages {
            msgs = msgs ~ [message_to_json(m)]
        }
        mut body: Map<string, dyn> = {"model": req.model, "messages": msgs}
        // The tools the agent offered, rendered flat so a test can assert that the derived schema
        // actually reached the wire — which is the difference between "the toolbox has a schema"
        // and "the model was told about it".
        if req.tools.len() > 0 {
            mut tools: List<dyn> = []
            for t in req.tools {
                entry: Map<string, dyn> = {
                    "name": t.name,
                    "description": t.description,
                    "schema": t.parameters,
                }
                tools = tools ~ [entry]
            }
            body = body.set("tools", tools)
        }
        match req.max_tokens {
            some(n) => {
                body = body.set("max_tokens", n)
            },
            none => {},
        }
        match req.temperature {
            some(t) => {
                body = body.set("temperature", t)
            },
            none => {},
        }
        if req.stop.len() > 0 {
            stop: List<dyn> = req.stop.map(fn(s) => s)
            body = body.set("stop", stop)
        }
        // The target is unreachable on purpose: if this mock is ever wired into a chain that does
        // reach the network, the failure is instant and obvious rather than a real request to a
        // real vendor. Loopback port 1 rather than a reserved `.invalid` host because it involves
        // **no resolver at all** — a `.invalid` lookup is only NXDOMAIN if the resolver honors RFC
        // 6761, and a hijacking one that answers with a parking page would turn a transport failure
        // into a decode failure and flake the suite.
        return Ok(Wire {
            url: "http://127.0.0.1:1/v1/messages",
            method: "post",
            headers: {"content-type": "application/json"},
            body: json.stringify(body),
        })
    }

    fn decode_reply(body: string): Result<ModelReply, AiError> {
        doc = provider.parse_object(body, "mock reply")?
        mut deltas: List<Delta> = []
        for (i, raw) in provider.list_at(doc, "parts").enumerate() {
            p = part_from_json(raw.as<Map<string, dyn>>() ?? {})?
            deltas = deltas ~ match p {
                Part.Text(text) => [Delta.TextDelta(id: "${i}", text: text)],
                Part.Thinking(text, signature) => [
                    Delta.ThinkingDelta(id: "${i}", text: text),
                    Delta.ThinkingSignature(id: "${i}", signature: signature),
                ],
                Part.ToolCall(id, name, args) => [
                    Delta.ToolCallStart(id: id, name: name),
                    Delta.ToolCallArgs(id: id, fragment: args),
                ],
                _ => [],
            }
        }
        usage = provider.obj_at(doc, "usage")
        deltas = deltas ~ [
            Delta.Stop(reason: stop_from_name(provider.str_at(doc, "stop"))),
            Delta.UsageDelta(usage: Usage {
                input_tokens: provider.int_at(usage, "input_tokens"),
                output_tokens: provider.int_at(usage, "output_tokens"),
            }),
        ]
        return Ok(provider.fold(deltas, provider.str_at(doc, "model")))
    }

    fn decode_error(status: int, body: string): AiError {
        return match provider.parse_object(body, "mock error") {
            Ok(doc) => AiError.Provider(
                status: status,
                code: provider.str_at(doc, "code"),
                message: provider.str_at(doc, "message"),
            ),
            Err(_) => AiError.Provider(status: status, code: "", message: body),
        }
    }

    // The `some(n)` half of O-5, so a caller's `match provider.estimate_tokens(...)` has both
    // branches reachable in a test. Rough by construction — a mock has nothing better to offer,
    // and saying `none` here would make the `some` path untestable without a real tokenizer.
    fn estimate_tokens(msgs: List<Message>): ?int {
        return some(provider.rough_token_estimate(msgs))
    }
}

// The transport half. A layer that never calls `next` answers on its own — which is exactly what a
// mock is, and why `para/api`'s middleware takes a callable `next` rather than a hook pair.
impl Middleware for Mock {
    fn handle(req: Request, next: Next): Result<Response, HttpError> {
        self.sent = self.sent ~ [req.body()]
        if self.cursor >= self.script.len() {
            // Loud. A run that outlasts its script is a test that scripted the wrong number of
            // turns, and answering something plausible would hide that.
            return Ok(server.response(500, json.stringify({
                "code": "mock_script_exhausted",
                "message": "the mock script ran out after ${self.cursor} scripted repl(y/ies)",
            })))
        }
        entry = self.script[self.cursor]
        self.cursor = self.cursor + 1
        input_tokens = req.body().len() / 4
        return Ok(match entry {
            Scripted.Failure(status, code, message) => server.response(status, json.stringify({
                "code": code,
                "message": message,
            })),
            _ => server.response(200, reply_body(entry, input_tokens)),
        })
    }
}

@test {
    fn a_scripted_text_answer_comes_back_through_the_whole_run_loop(): void {
        m = Mock.new().reply_text("18°C and clear in Malmö.")
        agent = m.agent(AgentConfig.new("test-model"))
        answer = match agent.run_sync("What's the weather in Malmö?") {
            Ok(s) => s,
            Err(e) => "FAILED: ${e}",
        }
        assert(answer == "18°C and clear in Malmö.", answer)
        assert(m.call_count() == 1)
        assert(m.remaining() == 0)
    }

    // The point of recording the *encoded* body: it proves the agent asked the right question, not
    // merely that it got an answer.
    fn calls_record_what_the_codec_actually_sent(): void {
        m = Mock.new().reply_text("ok")
        agent = m.agent(AgentConfig.new("test-model").with_system("Be terse.").with_max_tokens(32))
        one = agent.run_sync("hello")
        assert(m.calls().len() == 1)
        sent = m.calls()[0]
        assert(sent.contains("\"model\":\"test-model\""), sent)
        assert(sent.contains("\"max_tokens\":32"), sent)
        // The config's system prompt is prepended by the run loop, not by the caller.
        assert(sent.contains("\"role\":\"system\""), sent)
        assert(sent.contains("Be terse."), sent)
        assert(sent.contains("hello"), sent)
    }

    async fn a_run_returns_the_whole_conversation(): void {
        m = Mock.new().reply_text("second")
        agent = m.agent(AgentConfig.new("test-model"))
        conv = Conversation.of("first")
        match agent.run(conv).await {
            Ok(run) => {
                assert(run.turns == 1)
                assert(run.messages.len() == 2)
                assert(run.messages[0].role == Role.User)
                assert(run.messages[1].role == Role.Assistant)
                assert(run.text() == "second")
                assert(run.usage.output_tokens > 0, "usage is threaded out of the reply")
                assert(run.stop == StopReason.EndTurn)
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    // A refusal is `AiError.Refused`, never a decode failure — conflating them sends people
    // debugging the wrong thing.
    fn a_refusal_is_its_own_error(): void {
        m = Mock.new().refuse("I can't help with that.")
        agent = m.agent(AgentConfig.new("test-model"))
        match agent.run_sync("...") {
            Ok(s) => {
                assert(false, "a refusal is not an answer, got ${s}")
            },
            Err(e) => {
                assert(match e { AiError.Refused(reason) => reason == "I can't help with that.", _ => false }, "${e}")
            },
        }
    }

    // An HTTP error status is an answer with a typed body, decoded into a matchable code.
    fn a_vendor_error_status_becomes_a_typed_provider_error(): void {
        m = Mock.new().fail(429, "rate_limit_error", "slow down")
        agent = m.agent(AgentConfig.new("test-model"))
        match agent.run_sync("hi") {
            Ok(_) => {
                assert(false, "a 429 is not an answer")
            },
            Err(e) => {
                assert(match e {
                    AiError.Provider(status, code, message) => status == 429 && code == "rate_limit_error" && message == "slow down",
                    _ => false,
                }, "${e}")
            },
        }
    }

    // An agent with **no** toolbox cannot dispatch, so a tool-use stop finishes the run and hands
    // the requested call back intact rather than spinning. That is the only behavior that cannot
    // loop, and it is what phase 1 did.
    async fn a_tool_call_without_a_toolbox_ends_the_run(): void {
        m = Mock.new().reply_tool("call_1", "weather", "{\"city\":\"Malmö\"}")
        agent = m.agent(AgentConfig.new("test-model"))
        match agent.run(Conversation.of("weather?")).await {
            Ok(run) => {
                assert(run.stop == StopReason.ToolUse)
                calls = run.messages[run.messages.len() - 1].tool_calls()
                assert(calls == [Part.ToolCall(id: "call_1", name: "weather", args: "{\"city\":\"Malmö\"}")])
                assert(m.call_count() == 1, "and it does not go round again")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    // --- The tool loop ---------------------------------------------------------------------------
    //
    // The tools these drive are the `#[Tool]` functions declared at the bottom of *this* file, and
    // every assertion goes through `run_sync` plus `calls()` rather than through `run`. Both are
    // deliberate; both are worked around toolchain bugs, and both are recorded in AGENTS.md:
    //
    //   * `attributes_of::<T>()` sees only the **entry module's** annotations, so a `#[Tool]` in a
    //     sibling module is invisible to a suite rooted here.
    //   * an `async fn` in a `@test` block is called but **never driven**, so every assertion in one
    //     passes vacuously.
    //
    // `calls()` is not a lesser assertion, as it happens: it is the exact bytes the codec produced
    // for the *second* model call, which is to say the whole conversation including the tool turn.

    // The full cycle, with no socket in it: the model asks for a tool, the dispatcher calls the real
    // Noeta function, the result goes back as a turn, and the model answers.
    fn a_scripted_tool_call_dispatches_and_the_run_continues(): void {
        m = Mock.new()
            .reply_tool("call_1", "mock_shout", "{\"text\": \"hej\"}")
            .reply_text("It said HEJ.")
        assert(tool_agent_or_fail(m).run_sync("shout hej") == Ok("It said HEJ."))
        assert(m.call_count() == 2, "two model calls: the ask, then the answer")
        assert(m.remaining() == 0)
        // The second request carries the whole exchange — and `HEJ` is what the real `mock_shout`
        // returned, not anything the script said.
        second = m.calls()[1]
        assert(second.contains("\"role\":\"tool\""), second)
        assert(second.contains("{\"content\":\"HEJ\",\"id\":\"call_1\",\"is_error\":false,\"type\":\"tool_result\"}"),
            "the real function's return value went back to the model: ${second}")
    }

    // Parallel tool use in one turn: three calls, one tool turn carrying all three results, in call
    // order. One turn rather than three is load-bearing — several vendors reject consecutive
    // same-role turns, and a context strategy that split a `ToolCall` from its `ToolResult` would
    // produce the same rejection. Keeping them in one message makes that unrepresentable.
    fn parallel_tool_calls_come_back_as_one_turn_in_order(): void {
        m = Mock.new()
            .reply_tools([
                ScriptedCall { id: "a", name: "mock_shout", args: "{\"text\": \"one\"}" },
                ScriptedCall { id: "b", name: "mock_add", args: "{\"a\": 2, \"b\": 3}" },
                ScriptedCall { id: "c", name: "mock_shout", args: "{\"text\": \"three\"}" },
            ])
            .reply_text("done")
        assert(tool_agent_or_fail(m).run_sync("go") == Ok("done"))
        second = m.calls()[1]
        assert(second.contains("{\"parts\":[{\"content\":\"ONE\",\"id\":\"a\",\"is_error\":false,\"type\":\"tool_result\"},{\"content\":\"5\",\"id\":\"b\",\"is_error\":false,\"type\":\"tool_result\"},{\"content\":\"THREE\",\"id\":\"c\",\"is_error\":false,\"type\":\"tool_result\"}],\"role\":\"tool\"}"),
            "one tool turn, three results, in call order: ${second}")
    }

    // A concurrency cap of one is the sequential path through the same dispatcher, and it has to
    // produce byte-identical results — order comes from `map_bounded`, not from timing.
    fn the_concurrency_cap_does_not_change_the_answer(): void {
        assert(two_call_results(4) == two_call_results(1))
        assert(two_call_results(4).contains("\"content\":\"A\""), two_call_results(4))
    }

    // **A failing tool is a turn, not an outage.** An unknown name, an argument that will not
    // coerce, and a tool that returns `Err` all reach the model as `is_error: true` prose it can act
    // on — and the run finishes normally rather than aborting.
    fn a_failing_tool_is_a_turn_the_model_can_recover_from(): void {
        m = Mock.new()
            .reply_tools([
                ScriptedCall { id: "x", name: "nonexistent", args: "{}" },
                ScriptedCall { id: "y", name: "mock_add", args: "{\"a\": \"not a number\"}" },
                ScriptedCall { id: "z", name: "mock_add", args: "{\"a\": 9999999}" },
            ])
            .reply_text("I will try something else.")
        assert(tool_agent_or_fail(m).run_sync("go") == Ok("I will try something else."))
        second = m.calls()[1]
        assert(second.contains("no such tool"), second)
        assert(second.contains("expected an integer"), second)
        assert(second.contains("unreasonably large"), second)
        // All three came back flagged, so the model can tell them from answers.
        assert(!second.contains("\"is_error\":false"), "every result is a failure here: ${second}")
    }

    // The derived schema has to reach the wire, which is the difference between "the toolbox has a
    // schema" and "the model was told about it".
    fn the_derived_schema_reaches_the_request(): void {
        m = Mock.new().reply_text("ok")
        one = tool_agent_or_fail(m).run_sync("hi")
        sent = m.calls()[0]
        assert(sent.contains("\"name\":\"mock_shout\""), sent)
        assert(sent.contains("Echo a string back, uppercased"), sent)
        assert(sent.contains("The text to shout"), "the `#[Arg(help)]` too: ${sent}")
        assert(sent.contains("\\\"required\\\":[\\\"text\\\"]"), "and the derived requirements: ${sent}")
    }

    // The loop's hard rail. A model that keeps asking for tools is an error naming the limit, never
    // a truncated answer that looks complete.
    fn a_runaway_tool_loop_stops_at_max_turns(): void {
        again = "{\"text\": \"again\"}"
        m = Mock.new()
            .reply_tool("r0", "mock_shout", again)
            .reply_tool("r1", "mock_shout", again)
            .reply_tool("r2", "mock_shout", again)
            .reply_tool("r3", "mock_shout", again)
        agent = tool_agent_or_fail_with(m, AgentConfig.new("test-model").with_max_turns(3))
        match agent.run_sync("loop") {
            Ok(answer) => {
                assert(false, "a run that never finished is not an answer: ${answer}")
            },
            Err(e) => {
                assert(match e { AiError.MaxTurns(turns) => turns == 3, _ => false }, "${e}")
                assert("${e}".contains("max_turns"), "the message names the knob: ${e}")
            },
        }
        assert(m.call_count() == 3, "exactly the budget, not one more")
    }

    // A run that outlasts its script fails loudly rather than answering something plausible.
    fn an_exhausted_script_is_a_loud_failure(): void {
        m = Mock.new()
        agent = m.agent(AgentConfig.new("test-model"))
        match agent.run_sync("hi") {
            Ok(_) => {
                assert(false, "an unscripted call must not succeed")
            },
            Err(e) => {
                assert("${e}".contains("mock_script_exhausted"), "${e}")
            },
        }
        assert(m.call_count() == 1, "the call is still recorded — that is how you see it happened")
    }

    // The script is consumed in order, one entry per call, across separate runs.
    fn the_script_is_consumed_in_order(): void {
        m = Mock.new().reply_text("one").reply_text("two")
        agent = m.agent(AgentConfig.new("test-model"))
        assert(agent.run_sync("a") == Ok("one"))
        assert(m.remaining() == 1)
        assert(agent.run_sync("b") == Ok("two"))
        assert(m.remaining() == 0)
        assert(m.call_count() == 2)
    }

    // The transport arm: a chain with no mock layer bottoms out in the real client, and a request
    // that cannot leave the machine surfaces as `AiError.Transport` through `impl From<HttpError>`
    // — the one conversion `?` performs implicitly in the run loop.
    //
    // The mock codec addresses loopback port 1, so the connection is refused by the local kernel
    // without a resolver, a route, or a socket to anywhere. Fully hermetic: this passes identically
    // on a machine with no network at all.
    fn a_transport_failure_becomes_an_ai_error(): void {
        naked = Agent.over(AgentConfig.new("test-model"), Mock.new(), Api.new(client.new()))
        match naked.run_sync("hi") {
            Ok(_) => {
                assert(false, "a refused connection cannot answer")
            },
            Err(e) => {
                assert(match e { AiError.Transport(inner) => true, _ => false },
                    "a broken transport is `Transport`, not `Provider`: ${e}")
                assert("${e}".contains("transport failed"), "${e}")
            },
        }
    }

    // --- The codec, on its own ---------------------------------------------------------------

    // Every part kind survives the mock's own wire format, which is what makes `calls()` readable
    // for a conversation that is not just text.
    fn the_mock_codec_renders_every_part_kind(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message {
                role: Role.Assistant,
                parts: [
                    Part.Text(text: "hi"),
                    Part.Thinking(text: "hm", signature: "sig"),
                    Part.ToolCall(id: "t1", name: "w", args: "{}"),
                    Part.ToolResult(id: "t1", content: "18C", is_error: false),
                    Part.Image(mime: "image/png", data: "foobar".to_bytes()),
                    Part.File(mime: "application/pdf", name: "a.pdf", data: "xy".to_bytes()),
                ],
            }],
        }
        match Mock.new().encode(req) {
            Ok(w) => {
                assert(w.url == "http://127.0.0.1:1/v1/messages", "unreachable by construction")
                assert(w.body.contains("\"type\":\"thinking\""), w.body)
                assert(w.body.contains("\"signature\":\"sig\""), w.body)
                assert(w.body.contains("\"type\":\"tool_result\""), w.body)
                assert(w.body.contains("\"bytes\":6"), "an image is summarized by length: ${w.body}")
                assert(w.body.contains("\"name\":\"a.pdf\""), w.body)
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    // The `some(n)` half of `estimate_tokens(): ?int` — the branch Anthropic's `none` cannot cover.
    fn the_mock_estimates_tokens(): void {
        assert(match Mock.new().estimate_tokens([Message.user("a rather long sentence to count")]) {
            some(n) => n > 0,
            none => false,
        })
        // Longer input, larger estimate — the estimate tracks the content rather than being a
        // constant that happens to be positive.
        short = Mock.new().estimate_tokens([Message.user("hi")]) ?? 0
        long = Mock.new().estimate_tokens([Message.user("hi".repeat(200))]) ?? 0
        assert(long > short)
    }
}

// --- Test helpers -----------------------------------------------------------------------------
//
// Unwrap-or-fail for the two fallible doors a tool test goes through. A `match` arm cannot both
// fail an assertion and produce a value, so the unwrapping lives out here.

fn tool_agent_or_fail_with(m: Mock, cfg: AgentConfig): Agent<Mock> {
    match m.tool_agent(cfg, Local.new()) {
        Ok(a) => {
            return a
        },
        Err(e) => {
            assert(false, "attaching tools failed: ${e}")
        },
    }
    return m.agent(cfg)
}

fn tool_agent_or_fail(m: Mock): Agent<Mock> {
    return tool_agent_or_fail_with(m, AgentConfig.new("test-model"))
}

// The full conversation a two-call tool turn sends back, dispatched with `cap` calls in flight. The
// cap is the only thing that differs between the two runs a concurrency test compares.
fn two_call_results(cap: int): string {
    m = Mock.new()
        .reply_tools([
            ScriptedCall { id: "one", name: "mock_shout", args: "{\"text\": \"a\"}" },
            ScriptedCall { id: "two", name: "mock_shout", args: "{\"text\": \"b\"}" },
        ])
        .reply_text("done")
    agent = tool_agent_or_fail_with(m, AgentConfig.new("test-model").with_tool_concurrency(cap))
    one = agent.run_sync("go")
    return m.calls()[1]
}

// --- The tools these tests drive ------------------------------------------------------------------
//
// Declared **here** rather than borrowed from `para.ai.tools`, because `attributes_of::<T>()` sees
// only the entry module's annotations (AGENTS.md). Named `mock_*` so that when that is fixed
// upstream they simply join the other module's rather than colliding with them.

#[Tool(about: "Echo a string back, uppercased")]
fn mock_shout(#[Arg(help: "The text to shout")] text: string): string {
    return text.upper()
}

#[Tool(about: "Add two integers")]
fn mock_add(
    #[Arg(help: "The left operand")] a: int,
    #[Arg(help: "The right operand")] b: int = 1,
): Result<int, string> {
    if a > 1000000 {
        return Err("`a` is unreasonably large")
    }
    return Ok(a + b)
}
