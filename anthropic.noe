// A turn with extended thinking: four `thinking_delta`s, then the `signature_delta` that closes the
// block, then an ordinary text block. Two things this fixture pins that the others do not — the
// `message_start` here carries **no** `usage` object at all, and there is no `usage` on the
// `message_delta` either, so the whole call reports zero tokens and must not fail for it.
fn captured_thinking_stream(): List<string> {
    return [
        "event: message_start",
        "data: {\"type\": \"message_start\", \"message\": {\"id\": \"msg_01...\", \"type\": \"message\", \"role\": \"assistant\", \"content\": [], \"model\": \"claude-opus-5\", \"stop_reason\": null, \"stop_sequence\": null}}",
        "",
        "event: content_block_start",
        "data: {\"type\": \"content_block_start\", \"index\": 0, \"content_block\": {\"type\": \"thinking\", \"thinking\": \"\", \"signature\": \"\"}}",
        "",
        "event: content_block_delta",
        "data: {\"type\": \"content_block_delta\", \"index\": 0, \"delta\": {\"type\": \"thinking_delta\", \"thinking\": \"I need to find the GCD of 1071 and 462 using the Euclidean algorithm.\\n\\n1071 = 2 × 462 + 147\"}}",
        "",
        "event: content_block_delta",
        "data: {\"type\": \"content_block_delta\", \"index\": 0, \"delta\": {\"type\": \"thinking_delta\", \"thinking\": \"\\n462 = 3 × 147 + 21\"}}",
        "",
        "event: content_block_delta",
        "data: {\"type\": \"content_block_delta\", \"index\": 0, \"delta\": {\"type\": \"thinking_delta\", \"thinking\": \"\\n147 = 7 × 21 + 0\"}}",
        "",
        "event: content_block_delta",
        "data: {\"type\": \"content_block_delta\", \"index\": 0, \"delta\": {\"type\": \"thinking_delta\", \"thinking\": \"\\nThe remainder is 0, so GCD(1071, 462) = 21.\"}}",
        "",
        "event: content_block_delta",
        "data: {\"type\": \"content_block_delta\", \"index\": 0, \"delta\": {\"type\": \"signature_delta\", \"signature\": \"EqQBCgIYAhIM1gbcDa9GJwZA2b3hGgxBdjrkzLoky3dl1pkiMOYds...\"}}",
        "",
        "event: content_block_stop",
        "data: {\"type\": \"content_block_stop\", \"index\": 0}",
        "",
        "event: content_block_start",
        "data: {\"type\": \"content_block_start\", \"index\": 1, \"content_block\": {\"type\": \"text\", \"text\": \"\"}}",
        "",
        "event: content_block_delta",
        "data: {\"type\": \"content_block_delta\", \"index\": 1, \"delta\": {\"type\": \"text_delta\", \"text\": \"The greatest common divisor of 1071 and 462 is **21**.\"}}",
        "",
        "event: content_block_stop",
        "data: {\"type\": \"content_block_stop\", \"index\": 1}",
        "",
        "event: message_delta",
        "data: {\"type\": \"message_delta\", \"delta\": {\"stop_reason\": \"end_turn\", \"stop_sequence\": null}}",
        "",
        "event: message_stop",
        "data: {\"type\": \"message_stop\"}",
    ]
}

// A stream that dies mid-generation. Anthropic sends `event: error` inside an already-successful
// 200 response, so the transport reports nothing wrong and the only evidence is in the frames.
fn captured_interrupted_stream(): List<string> {
    return [
        "event: message_start",
        "data: {\"type\": \"message_start\", \"message\": {\"id\": \"msg_01...\", \"type\": \"message\", \"role\": \"assistant\", \"content\": [], \"model\": \"claude-opus-5\", \"stop_reason\": null, \"stop_sequence\": null}}",
        "",
        "event: content_block_start",
        "data: {\"type\": \"content_block_start\", \"index\": 0, \"content_block\": {\"type\": \"text\", \"text\": \"\"}}",
        "",
        "event: content_block_delta",
        "data: {\"type\": \"content_block_delta\", \"index\": 0, \"delta\": {\"type\": \"text_delta\", \"text\": \"Hello\"}}",
        "",
        "event: error",
        "data: {\"type\": \"error\", \"error\": {\"type\": \"overloaded_error\", \"message\": \"Overloaded\"}}",
    ]
}

// Cut a verbatim transcript into the frames `std.http`'s reader hands back: `event:` names the
// frame, `data:` lines join with a newline between them, and a blank line dispatches what has
// accumulated. Test-only — the run loop never sees wire text, it sees frames std already cut.
fn sse_frames(lines: List<string>): List<Frame> {
    mut out: List<Frame> = []
    mut event = ""
    mut data = ""
    mut open = false
    for line in lines {
        if line == "" {
            if open {
                out = out ~ [Frame { event: event, data: data, id: "", retry: none }]
            }
            event = ""
            data = ""
            open = false
        } else if line.starts_with("event: ") {
            event = line.slice(7, line.len())
            open = true
        } else if line.starts_with("data: ") {
            piece = line.slice(6, line.len())
            data = if data == "" then piece else data ~ "\n" ~ piece
            open = true
        }
    }
    if open {
        out = out ~ [Frame { event: event, data: data, id: "", retry: none }]
    }
    return out
}

// Replay a transcript through a fresh decoder, one frame at a time, exactly as the run loop does.
// The deltas are what `push` produced; `finish` is asserted separately, because whether a stream
// ended where it should is a different question from what it said.
fn stream_or_fail(decoder: dyn StreamDecoder, lines: List<string>): List<Delta> {
    mut out: List<Delta> = []
    for f in sse_frames(lines) {
        match decoder.push(f) {
            Ok(more) => {
                out = out ~ more
            },
            Err(e) => {
                assert(false, "push failed on `${f.event}`: ${e}")
            },
        }
    }
    return out
}

fn captured_text_reply(): string {
    return "{\"id\":\"msg_01XFDUDYJgAACzvnptvVoYEL\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"claude-opus-5\",\"content\":[{\"type\":\"text\",\"text\":\"Hej! Hur mår du?\"}],\"stop_reason\":\"end_turn\",\"stop_sequence\":null,\"usage\":{\"input_tokens\":2095,\"cache_creation_input_tokens\":0,\"cache_read_input_tokens\":1024,\"output_tokens\":503}}"
}

fn captured_tool_use_reply(): string {
    return "{\"id\":\"msg_01Aq9w8rhu5yE8CHnK516NS\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"claude-opus-5\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"The user wants the weather.\",\"signature\":\"ErUBCkYIBBgCIkD\"},{\"type\":\"text\",\"text\":\"Let me check.\"},{\"type\":\"tool_use\",\"id\":\"toolu_01A09q90qw90lq917835lq9\",\"name\":\"get_weather\",\"input\":{\"city\":\"Malmö\",\"unit\":\"celsius\"}}],\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"usage\":{\"input_tokens\":472,\"output_tokens\":91}}"
}

@test {
    // A known request, asserted against the exact bytes it produces. `json.stringify` emits map
    // keys in sorted order, so this is stable — and an exact-string assertion is the only kind that
    // catches a key silently changing name or moving nesting level.
    fn encode_produces_exactly_this_json(): void {
        req = ModelRequest {
            model: "claude-opus-5",
            messages: [
                Message.system("Answer in Swedish."),
                Message.user("Say hello."),
            ],
            max_tokens: some(64),
            temperature: some(0.0),
            stop: ["\n\n"],
        }
        wire = encode_or_fail(Anthropic.new("sk-test"), req)
        assert(wire.url == "https://api.anthropic.com/v1/messages")
        assert(wire.method == "post")
        assert(wire.body == "{\"max_tokens\":64,\"messages\":[{\"content\":[{\"text\":\"Say hello.\",\"type\":\"text\"}],\"role\":\"user\"}],\"model\":\"claude-opus-5\",\"stop_sequences\":[\"\\n\\n\"],\"system\":[{\"text\":\"Answer in Swedish.\",\"type\":\"text\"}],\"temperature\":0.0}",
            "exact request body, got: ${wire.body}")
    }

    fn encode_sends_the_vendors_headers(): void {
        req = ModelRequest { model: "m", messages: [Message.user("hi")] }
        match Anthropic.new("sk-abc").with_beta("token-counting-2024-11-01").encode(req) {
            Ok(w) => {
                assert(w.headers["x-api-key"] == "sk-abc")
                assert(w.headers["anthropic-version"] == "2023-06-01")
                assert(w.headers["content-type"] == "application/json")
                assert(w.headers["anthropic-beta"] == "token-counting-2024-11-01")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
        // No beta flags, no header — an empty `anthropic-beta` is not the same as an absent one.
        match Anthropic.new("k").encode(req) {
            Ok(w) => {
                assert(!w.headers.has("anthropic-beta"))
            },
            Err(_) => {
                assert(false)
            },
        }
    }

    // `max_tokens` is required by the vendor, so a request that omits it still produces a valid
    // body rather than a 400.
    fn encode_supplies_the_required_max_tokens(): void {
        req = ModelRequest { model: "m", messages: [Message.user("hi")] }
        match Anthropic.new("k").encode(req) {
            Ok(w) => {
                assert(w.body.contains("\"max_tokens\":4096"))
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    fn encode_points_at_a_gateway_when_told_to(): void {
        req = ModelRequest { model: "m", messages: [Message.user("hi")] }
        match Anthropic.at("https://gateway.internal", "k").encode(req) {
            Ok(w) => {
                assert(w.url == "https://gateway.internal/v1/messages")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    // A system turn is hoisted out of `messages` wherever it appears — the vendor rejects a
    // `"role": "system"` entry, and a mid-conversation reminder is a real pattern.
    fn encode_hoists_every_system_turn(): void {
        req = ModelRequest {
            model: "m",
            messages: [
                Message.system("first"),
                Message.user("a"),
                Message.system("second"),
                Message.assistant("b"),
            ],
        }
        match Anthropic.new("k").encode(req) {
            Ok(w) => {
                assert(w.body.contains("\"system\":[{\"text\":\"first\",\"type\":\"text\"},{\"text\":\"second\",\"type\":\"text\"}]"),
                    "both system turns hoisted, in order: ${w.body}")
                assert(!w.body.contains("\"role\":\"system\""), "no system role reaches `messages`")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    // The cache breakpoint, asserted against the exact bytes. A `@prompt` split at its first hole
    // reaches this codec as two system turns, and the marker goes on the **first** block — so the
    // cached prefix ends where the author's fixed text ends and not one character later.
    fn a_cache_breakpoint_marks_exactly_the_stable_block(): void {
        req = ModelRequest {
            model: "m",
            messages: [
                Message.system("You work for ").cached(),
                Message.system("Acme. Be brief."),
                Message.user("hi"),
            ],
            max_tokens: some(16),
        }
        wire = encode_or_fail(Anthropic.new("k"), req)
        assert(wire.body.contains("\"system\":[{\"cache_control\":{\"type\":\"ephemeral\"},\"text\":\"You work for \",\"type\":\"text\"},{\"text\":\"Acme. Be brief.\",\"type\":\"text\"}]"),
            "the marker is on the stable block and only that one: ${wire.body}")
        // Exactly one marker in the whole request.
        assert(wire.body.split("cache_control").len() == 2, "one marker: ${wire.body}")
    }

    // A prompt that interpolates nothing is one block, marked — the maximal prefix, which is the
    // best case for a cache and not a degenerate one.
    fn a_static_system_prompt_caches_in_its_entirety(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message.system("Answer in one sentence.").cached(), Message.user("hi")],
            max_tokens: some(16),
        }
        wire = encode_or_fail(Anthropic.new("k"), req)
        assert(wire.body.contains("\"system\":[{\"cache_control\":{\"type\":\"ephemeral\"},\"text\":\"Answer in one sentence.\",\"type\":\"text\"}]"),
            "${wire.body}")
    }

    // Nothing is marked unless something asked for it. A codec that stamped `cache_control` on
    // every system block would charge a cache write on requests that never repeat.
    fn an_unmarked_request_carries_no_cache_control(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message.system("Answer in Swedish."), Message.user("hi")],
        }
        assert(!encode_or_fail(Anthropic.new("k"), req).body.contains("cache_control"))
    }

    // The marker survives the alternation merge. A marked `user` turn followed by another one
    // becomes a single turn with two blocks, and the marker stays on the block it was placed on —
    // mid-array, which is legal and is what "cacheable up to here" means.
    fn a_merged_turn_keeps_the_marker_on_the_block_it_was_placed_on(): void {
        req = ModelRequest {
            model: "m",
            messages: [
                Message.user("a long retrieved corpus").cached(),
                Message.user("now answer this"),
            ],
            max_tokens: some(16),
        }
        wire = encode_or_fail(Anthropic.new("k"), req)
        assert(wire.body.contains("\"content\":[{\"cache_control\":{\"type\":\"ephemeral\"},\"text\":\"a long retrieved corpus\",\"type\":\"text\"},{\"text\":\"now answer this\",\"type\":\"text\"}]"),
            "one merged turn, marker on the first block: ${wire.body}")
    }

    // Four is the vendor's limit, and it is rejected here rather than after a round trip — a 400
    // whose body says `at most 4 blocks with cache_control` names no message and costs a request.
    fn a_fifth_breakpoint_is_refused_at_encode(): void {
        four = ModelRequest {
            model: "m",
            messages: [
                Message.system("a").cached(),
                Message.user("b").cached(),
                Message.assistant("c").cached(),
                Message.user("d").cached(),
            ],
        }
        assert(encode_or_fail(Anthropic.new("k"), four).body.contains("cache_control"), "four is fine")

        five = ModelRequest { model: "m", messages: four.messages ~ [Message.assistant("e").cached()] }
        match Anthropic.new("k").encode(five) {
            Ok(w) => {
                assert(false, "a fifth breakpoint is not encodable: ${w.body}")
            },
            Err(e) => {
                assert("${e}".contains("at most 4"), "${e}")
                assert("${e}".contains("marks 5 messages"), "${e}")
            },
        }
    }

    // A marker needs a block to sit on. A turn that produced none is left alone rather than
    // growing an empty content entry to carry it — and it does not count against the limit.
    fn a_marked_turn_with_no_content_is_left_alone(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message { role: Role.User, parts: [], cache_breakpoint: true }, Message.user("hi")],
        }
        assert(!encode_or_fail(Anthropic.new("k"), req).body.contains("cache_control"))
    }

    // Anthropic has no `tool` role: a tool result rides a `user` turn.
    fn encode_carries_tool_results_on_a_user_turn(): void {
        req = ModelRequest {
            model: "m",
            messages: [
                Message.user("weather?"),
                Message {
                    role: Role.Assistant,
                    parts: [Part.ToolCall(id: "toolu_1", name: "weather", args: "{\"city\":\"Malmo\"}")],
                },
                Message.tool("toolu_1", "18C", false),
            ],
        }
        match Anthropic.new("k").encode(req) {
            Ok(w) => {
                assert(w.body.contains("{\"id\":\"toolu_1\",\"input\":{\"city\":\"Malmo\"},\"name\":\"weather\",\"type\":\"tool_use\"}"),
                    "the raw args string is embedded as real JSON, not as a string: ${w.body}")
                assert(w.body.contains("{\"content\":[{\"content\":\"18C\",\"is_error\":false,\"tool_use_id\":\"toolu_1\",\"type\":\"tool_result\"}],\"role\":\"user\"}"),
                    "tool results ride a user turn: ${w.body}")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    // A tool's schema is raw JSON Schema text, so it has to reach the vendor as real JSON — a
    // quoted string here would read as one string-typed parameter named nothing.
    fn encode_sends_the_tools_as_input_schema(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message.user("weather?")],
            tools: [ToolSpec {
                name: "weather",
                description: "Current weather for a city",
                parameters: "{\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"],\"type\":\"object\"}",
            }],
        }
        wire = encode_or_fail(Anthropic.new("k"), req)
        assert(wire.body.contains("\"tools\":[{\"description\":\"Current weather for a city\",\"input_schema\":{\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"],\"type\":\"object\"},\"name\":\"weather\"}]"),
            wire.body)
    }

    // No tools, no key: an empty `tools` array is not the same request as an absent one, and a
    // vendor is entitled to treat it differently.
    fn encode_omits_the_tools_key_when_there_are_none(): void {
        req = ModelRequest { model: "m", messages: [Message.user("hi")] }
        assert(!encode_or_fail(Anthropic.new("k"), req).body.contains("\"tools\""))
    }

    // A schema that is not JSON at all is caught at encode, naming the tool, rather than becoming
    // an opaque vendor 400.
    fn encode_rejects_a_tool_whose_schema_is_not_json(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message.user("hi")],
            tools: [ToolSpec { name: "broken", description: "", parameters: "{oops" }],
        }
        match Anthropic.new("k").encode(req) {
            Ok(_) => {
                assert(false, "a malformed schema must not encode")
            },
            Err(e) => {
                assert("${e}".contains("broken"), "${e}")
                assert("${e}".contains("anthropic"), "${e}")
            },
        }
    }

    // The Messages API requires user and assistant turns to alternate, and `Role.Tool` encodes as
    // `user` — so a tool turn following a user turn would be two consecutive `user` entries and a
    // 400 whose message says nothing about tools. Adjacent same-role turns are merged.
    fn encode_merges_adjacent_turns_of_the_same_role(): void {
        req = ModelRequest {
            model: "m",
            messages: [
                Message.user("first"),
                Message.user("second"),
            ],
        }
        wire = encode_or_fail(Anthropic.new("k"), req)
        assert(wire.body.contains("\"messages\":[{\"content\":[{\"text\":\"first\",\"type\":\"text\"},{\"text\":\"second\",\"type\":\"text\"}],\"role\":\"user\"}]"),
            "one user turn carrying both: ${wire.body}")
    }

    // The shape a tool loop actually produces: a user question, an assistant turn with two parallel
    // tool calls, and one tool turn carrying both results. Three wire turns, strictly alternating.
    fn encode_round_trips_a_parallel_tool_turn(): void {
        req = ModelRequest {
            model: "m",
            messages: [
                Message.user("weather in both?"),
                Message {
                    role: Role.Assistant,
                    parts: [
                        Part.ToolCall(id: "t1", name: "weather", args: "{\"city\":\"Malmo\"}"),
                        Part.ToolCall(id: "t2", name: "weather", args: "{\"city\":\"Lund\"}"),
                    ],
                },
                Message {
                    role: Role.Tool,
                    parts: [
                        Part.ToolResult(id: "t1", content: "18C", is_error: false),
                        Part.ToolResult(id: "t2", content: "17C", is_error: false),
                    ],
                },
            ],
        }
        wire = encode_or_fail(Anthropic.new("k"), req)
        assert(wire.body.contains("\"tool_use_id\":\"t1\""), wire.body)
        assert(wire.body.contains("\"tool_use_id\":\"t2\""), wire.body)
        // Strict alternation: user, assistant, user — and no run of two same-role entries.
        assert(!wire.body.contains("\"role\":\"user\"},{\"content\":[{\"content\":"), wire.body)
    }

    // The signature has to come back or the vendor invalidates the block; nothing here reads it.
    fn encode_round_trips_a_thinking_signature(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message {
                role: Role.Assistant,
                parts: [Part.Thinking(text: "let me see", signature: "EqQBCgIYAh")],
            }],
        }
        match Anthropic.new("k").encode(req) {
            Ok(w) => {
                assert(w.body.contains("{\"signature\":\"EqQBCgIYAh\",\"thinking\":\"let me see\",\"type\":\"thinking\"}"),
                    "${w.body}")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    fn encode_inlines_an_image_as_base64(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message {
                role: Role.User,
                parts: [Part.Image(mime: "image/png", data: "foobar".to_bytes())],
            }],
        }
        match Anthropic.new("k").encode(req) {
            Ok(w) => {
                assert(w.body.contains("{\"data\":\"Zm9vYmFy\",\"media_type\":\"image/png\",\"type\":\"base64\"}"),
                    "${w.body}")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    // Loud, at encode, naming the part and the provider — a codec that silently dropped this
    // would answer a question the user never asked.
    fn encode_rejects_a_part_the_vendor_cannot_express(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message {
                role: Role.User,
                parts: [Part.File(mime: "video/mp4", name: "clip.mp4", data: "x".to_bytes())],
            }],
        }
        match Anthropic.new("k").encode(req) {
            Ok(w) => {
                assert(false, "a video must not silently encode")
            },
            Err(e) => {
                assert("${e}".contains("anthropic"), "${e}")
                assert("${e}".contains("clip.mp4"), "the message names the part: ${e}")
                assert("${e}".contains("application/pdf"), "and what would work: ${e}")
            },
        }
    }

    fn encode_rejects_a_tool_call_whose_arguments_are_not_json(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message {
                role: Role.Assistant,
                parts: [Part.ToolCall(id: "t1", name: "weather", args: "{city: Malmo")],
            }],
        }
        match Anthropic.new("k").encode(req) {
            Ok(_) => {
                assert(false, "malformed arguments must not encode")
            },
            Err(e) => {
                assert("${e}".contains("weather"), "${e}")
            },
        }
    }

    // The escape hatch is unchecked in content but not in syntax: a fragment that is not JSON is
    // caught here rather than becoming an opaque vendor 400.
    fn encode_merges_the_extra_escape_hatch(): void {
        req = ModelRequest {
            model: "m",
            messages: [Message.user("hi")],
            extra: {"thinking": "{\"type\": \"adaptive\"}", "top_k": "5"},
        }
        match Anthropic.new("k").encode(req) {
            Ok(w) => {
                assert(w.body.contains("\"thinking\":{\"type\":\"adaptive\"}"), "${w.body}")
                assert(w.body.contains("\"top_k\":5"), "${w.body}")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
        broken = ModelRequest { model: "m", messages: [], extra: {"thinking": "{oops"} }
        match Anthropic.new("k").encode(broken) {
            Ok(_) => {
                assert(false, "a malformed fragment must be caught at encode")
            },
            Err(e) => {
                assert("${e}".contains("thinking"), "${e}")
            },
        }
    }

    // --- Decoding a real captured response body ---------------------------------------------------

    // A verbatim Anthropic `POST /v1/messages` response — the shape the vendor documents, keys and

    fn decode_reads_a_captured_text_reply(): void {
        match Anthropic.new("k").decode_reply(captured_text_reply()) {
            Ok(reply) => {
                assert(reply.parts == [Part.Text(text: "Hej! Hur mår du?")])
                assert(reply.stop == StopReason.EndTurn)
                assert(reply.model == "claude-opus-5")
                assert(reply.usage.input_tokens == 2095)
                assert(reply.usage.output_tokens == 503)
                assert(reply.usage.cached_input_tokens == 1024, "cache reads are the cached input")
                assert(reply.usage.reasoning_tokens == 0, "Anthropic folds reasoning into output")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    // A captured reply with thinking, prose, and a tool call in one turn — the shape an extended

    fn decode_reads_a_captured_tool_use_reply(): void {
        match Anthropic.new("k").decode_reply(captured_tool_use_reply()) {
            Ok(reply) => {
                assert(reply.stop == StopReason.ToolUse)
                assert(reply.parts.len() == 3)
                assert(reply.parts[0] == Part.Thinking(text: "The user wants the weather.", signature: "ErUBCkYIBBgCIkD"))
                assert(reply.parts[1] == Part.Text(text: "Let me check."))
                // The vendor's own call id, not the block index — a `tool_result` has to address it.
                // Arguments come back as raw JSON with keys in `json.stringify`'s sorted order.
                assert(reply.parts[2] == Part.ToolCall(
                    id: "toolu_01A09q90qw90lq917835lq9",
                    name: "get_weather",
                    args: "{\"city\":\"Malmö\",\"unit\":\"celsius\"}",
                ))
                assert(reply.usage.cached_input_tokens == 0, "an absent cache field reads as zero")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    // A reply → request round trip: what the model said, sent straight back as history, has to be
    // re-encodable. This is the property that catches a decode which loses the tool id or the
    // thinking signature.
    fn a_decoded_reply_re_encodes_as_history(): void {
        codec = Anthropic.new("k")
        reply = decode_or_fail(codec, captured_tool_use_reply())
        history = [
            Message.user("weather in Malmö?"),
            Message { role: Role.Assistant, parts: reply.parts },
            Message.tool("toolu_01A09q90qw90lq917835lq9", "18°C, clear", false),
        ]
        match codec.encode(ModelRequest { model: "claude-opus-5", messages: history }) {
            Ok(w) => {
                assert(w.body.contains("\"signature\":\"ErUBCkYIBBgCIkD\""), "the signature survives")
                assert(w.body.contains("\"tool_use_id\":\"toolu_01A09q90qw90lq917835lq9\""), "the id survives")
                assert(w.body.contains("\"input\":{\"city\":\"Malmö\",\"unit\":\"celsius\"}"),
                    "the arguments go back as JSON, not as a quoted string")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }

    fn decode_maps_every_stop_reason(): void {
        assert(decode_stop("end_turn") == StopReason.EndTurn)
        assert(decode_stop("") == StopReason.EndTurn, "an absent stop reason is a normal end")
        assert(decode_stop("tool_use") == StopReason.ToolUse)
        assert(decode_stop("max_tokens") == StopReason.MaxTokens)
        assert(decode_stop("stop_sequence") == StopReason.StopSequence)
        assert(decode_stop("refusal") == StopReason.Refusal)
        // Unmodeled reasons survive rather than being reported as a clean finish.
        assert(decode_stop("pause_turn") == StopReason.Other(raw: "pause_turn"))
    }

    // Silently dropping a block nobody modeled would turn a partial answer into one that looks
    // complete. The path names the block.
    fn decode_rejects_an_unknown_content_block(): void {
        body = "{\"model\":\"m\",\"content\":[{\"type\":\"text\",\"text\":\"a\"},{\"type\":\"server_tool_use\",\"id\":\"x\"}],\"stop_reason\":\"end_turn\"}"
        match Anthropic.new("k").decode_reply(body) {
            Ok(_) => {
                assert(false, "an unmodeled block must not be dropped")
            },
            Err(e) => {
                assert("${e}".contains("content[1].type"), "the path names the block: ${e}")
                assert("${e}".contains("server_tool_use"), "${e}")
            },
        }
    }

    fn decode_reports_a_malformed_body_rather_than_aborting(): void {
        match Anthropic.new("k").decode_reply("<html>502 Bad Gateway</html>") {
            Ok(_) => {
                assert(false, "HTML is not a reply")
            },
            Err(e) => {
                assert("${e}".contains("anthropic reply"), "${e}")
            },
        }
    }

    // --- Error bodies ------------------------------------------------------------------------------

    fn decode_error_reads_the_vendors_typed_error(): void {
        body = "{\"type\":\"error\",\"error\":{\"type\":\"rate_limit_error\",\"message\":\"Number of request tokens has exceeded your per-minute rate limit\"},\"request_id\":\"req_011CSHoE\"}"
        e = Anthropic.new("k").decode_error(429, body)
        // `code` is matchable; nobody has to regex the prose.
        assert(match e {
            AiError.Provider(status, code, message) => status == 429 && code == "rate_limit_error"
                && message.contains("per-minute rate limit"),
            _ => false,
        }, "${e}")
    }

    // An HTML error page from a proxy is not the documented envelope; its text is the only evidence
    // of what answered, so it is reported verbatim instead of swallowed.
    fn decode_error_keeps_an_undecodable_body_verbatim(): void {
        e = Anthropic.new("k").decode_error(502, "<html>Bad Gateway</html>")
        assert(match e {
            AiError.Provider(status, code, message) => status == 502 && code == ""
                && message == "<html>Bad Gateway</html>",
            _ => false,
        }, "${e}")
    }

    // O-5, demonstrated: Anthropic ships no local tokenizer, so it says so rather than guessing.
    fn estimate_tokens_is_none_because_there_is_no_local_tokenizer(): void {
        assert(Anthropic.new("k").estimate_tokens([Message.user("hello")]) == none)
    }

    // --- Streaming ---------------------------------------------------------------------------------

    // Asking for a stream is one body key and one framing, set together. A request that did not ask
    // gets neither — an absent `stream` key is not the same request as `"stream": false`.
    fn encode_asks_for_a_stream_only_when_the_request_does(): void {
        buffered = encode_or_fail(Anthropic.new("k"), ModelRequest {
            model: "m",
            messages: [Message.user("hi")],
        })
        assert(!buffered.body.contains("\"stream\""), buffered.body)
        assert(!buffered.streamed(), "and the wire says so")

        streamed = encode_or_fail(Anthropic.new("k"), ModelRequest {
            model: "m",
            messages: [Message.user("hi")],
            stream: true,
        })
        assert(streamed.body.contains("\"stream\":true"), streamed.body)
        assert(streamed.streamed())
        assert(!streamed.ndjson(), "Anthropic speaks server-sent events")
    }

    // The captured basic transcript, frame by frame. Every delta, in order — a "did it finish"
    // assertion would pass on a decoder that dropped the `ping`, mislabeled the block, or lost the
    // input token count when the output count arrived.
    fn a_captured_text_stream_decodes_frame_by_frame(): void {
        decoder: dyn StreamDecoder = AnthropicStream.new()
        deltas = stream_or_fail(decoder, captured_text_stream())
        assert(deltas == [
            Delta.ModelDelta(model: "claude-opus-5"),
            Delta.UsageDelta(usage: Usage { input_tokens: 25, output_tokens: 1 }),
            Delta.TextDelta(id: "0", text: "Hello"),
            Delta.TextDelta(id: "0", text: "!"),
            Delta.Stop(reason: StopReason.EndTurn),
            // `message_delta` reports only the output count; the input count from `message_start`
            // survives rather than being overwritten with a zero.
            Delta.UsageDelta(usage: Usage { input_tokens: 25, output_tokens: 15 }),
        ], "${deltas}")
        assert(decoder.finish() == Ok(Usage { input_tokens: 25, output_tokens: 15 }))

        reply = provider.fold(deltas, "")
        assert(reply.parts == [Part.Text(text: "Hello!")])
        assert(reply.model == "claude-opus-5", "the served model rode in on `message_start`")
        assert(reply.stop == StopReason.EndTurn)
        assert(reply.usage == Usage { input_tokens: 25, output_tokens: 15 })
    }

    // The captured tool-use transcript. The arguments arrive as six partial-JSON fragments, five of
    // which are not valid JSON on their own and the first of which is empty — which is exactly why
    // `Part.ToolCall.args` is a raw string with one accumulate-then-decode boundary.
    fn a_captured_tool_use_stream_decodes_frame_by_frame(): void {
        decoder: dyn StreamDecoder = AnthropicStream.new()
        deltas = stream_or_fail(decoder, captured_tool_use_stream())
        assert(deltas == [
            Delta.ModelDelta(model: "claude-opus-5"),
            Delta.UsageDelta(usage: Usage { input_tokens: 472, output_tokens: 2 }),
            Delta.TextDelta(id: "0", text: "Okay"),
            Delta.TextDelta(id: "0", text: ","),
            Delta.TextDelta(id: "0", text: " let"),
            Delta.TextDelta(id: "0", text: "'s"),
            Delta.TextDelta(id: "0", text: " check"),
            Delta.TextDelta(id: "0", text: " the"),
            Delta.TextDelta(id: "0", text: " weather"),
            Delta.TextDelta(id: "0", text: " for"),
            Delta.TextDelta(id: "0", text: " San"),
            Delta.TextDelta(id: "0", text: " Francisco"),
            Delta.TextDelta(id: "0", text: ","),
            Delta.TextDelta(id: "0", text: " CA"),
            Delta.TextDelta(id: "0", text: ":"),
            // The vendor's own call id, not the block index — a `tool_result` has to address it.
            Delta.ToolCallStart(id: "toolu_01T1x1fJ34qAmk2tNTrN7Up6", name: "get_weather"),
            // The leading empty fragment is dropped: it carries nothing and would put a
            // zero-length delta in the event stream.
            Delta.ToolCallArgs(id: "toolu_01T1x1fJ34qAmk2tNTrN7Up6", fragment: "{\"location\":"),
            Delta.ToolCallArgs(id: "toolu_01T1x1fJ34qAmk2tNTrN7Up6", fragment: " \"San"),
            Delta.ToolCallArgs(id: "toolu_01T1x1fJ34qAmk2tNTrN7Up6", fragment: " Francisc"),
            Delta.ToolCallArgs(id: "toolu_01T1x1fJ34qAmk2tNTrN7Up6", fragment: "o,"),
            Delta.ToolCallArgs(id: "toolu_01T1x1fJ34qAmk2tNTrN7Up6", fragment: " CA\"}"),
            Delta.Stop(reason: StopReason.ToolUse),
            Delta.UsageDelta(usage: Usage { input_tokens: 472, output_tokens: 89 }),
        ], "${deltas}")
        assert(decoder.finish() == Ok(Usage { input_tokens: 472, output_tokens: 89 }))

        reply = provider.fold(deltas, "")
        assert(reply.stop == StopReason.ToolUse)
        assert(reply.parts == [
            Part.Text(text: "Okay, let's check the weather for San Francisco, CA:"),
            Part.ToolCall(
                id: "toolu_01T1x1fJ34qAmk2tNTrN7Up6",
                name: "get_weather",
                args: "{\"location\": \"San Francisco, CA\"}",
            ),
        ], "${reply.parts}")
    }

    // The captured thinking transcript. The signature arrives as its own delta after the prose,
    // and it has to land on the same block — the vendor invalidates a thinking block that comes
    // back without it.
    fn a_captured_thinking_stream_decodes_frame_by_frame(): void {
        decoder: dyn StreamDecoder = AnthropicStream.new()
        deltas = stream_or_fail(decoder, captured_thinking_stream())
        assert(deltas == [
            Delta.ModelDelta(model: "claude-opus-5"),
            Delta.ThinkingDelta(id: "0", text: "I need to find the GCD of 1071 and 462 using the Euclidean algorithm.\n\n1071 = 2 × 462 + 147"),
            Delta.ThinkingDelta(id: "0", text: "\n462 = 3 × 147 + 21"),
            Delta.ThinkingDelta(id: "0", text: "\n147 = 7 × 21 + 0"),
            Delta.ThinkingDelta(id: "0", text: "\nThe remainder is 0, so GCD(1071, 462) = 21."),
            Delta.ThinkingSignature(id: "0", signature: "EqQBCgIYAhIM1gbcDa9GJwZA2b3hGgxBdjrkzLoky3dl1pkiMOYds..."),
            Delta.TextDelta(id: "1", text: "The greatest common divisor of 1071 and 462 is **21**."),
            Delta.Stop(reason: StopReason.EndTurn),
        ], "${deltas}")
        // This transcript reports no tokens anywhere — no `usage` on `message_start` and none on
        // `message_delta`. A decoder that required one would fail a real, published stream.
        assert(decoder.finish() == Ok(Usage {}))

        reply = provider.fold(deltas, "")
        assert(reply.parts == [
            Part.Thinking(
                text: "I need to find the GCD of 1071 and 462 using the Euclidean algorithm.\n\n1071 = 2 × 462 + 147\n462 = 3 × 147 + 21\n147 = 7 × 21 + 0\nThe remainder is 0, so GCD(1071, 462) = 21.",
                signature: "EqQBCgIYAhIM1gbcDa9GJwZA2b3hGgxBdjrkzLoky3dl1pkiMOYds...",
            ),
            Part.Text(text: "The greatest common divisor of 1071 and 462 is **21**."),
        ], "${reply.parts}")
    }

    // The vendor sends `event: error` inside an already-successful 200 response, so the transport
    // reports nothing wrong. `code` stays matchable; the status is `0` because there genuinely is
    // none, which is more honest than inventing 529.
    fn an_error_frame_is_the_vendors_typed_error(): void {
        decoder: dyn StreamDecoder = AnthropicStream.new()
        mut seen: ?AiError = none
        for f in sse_frames(captured_interrupted_stream()) {
            match decoder.push(f) {
                Ok(_) => {},
                Err(e) => {
                    seen = some(e)
                },
            }
        }
        assert(match seen {
            some(e) => match e {
                AiError.Provider(status, code, message) => status == 0
                    && code == "overloaded_error" && message == "Overloaded",
                _ => false,
            },
            none => false,
        }, "${seen}")
    }

    // **A truncated stream must not look like a complete answer.** This is what `finish` is for: the
    // frames that did arrive decode perfectly well, and only the missing terminator says the reply
    // is half of one.
    fn a_truncated_stream_is_refused_rather_than_answered(): void {
        full = captured_text_stream()
        // Drop the trailing blank line, `event: message_stop`, and its data.
        cut = full.slice(0, full.len() - 3)
        decoder: dyn StreamDecoder = AnthropicStream.new()
        deltas = stream_or_fail(decoder, cut)
        assert(deltas.len() > 0, "the frames that arrived still decode")
        match decoder.finish() {
            Ok(u) => {
                assert(false, "a stream with no `message_stop` is not a finished reply: ${u}")
            },
            Err(e) => {
                assert("${e}".contains("message_stop"), "${e}")
                assert("${e}".contains("truncated"), "${e}")
            },
        }
    }

    // A stream that carried nothing at all is the shape a vendor error status takes today, because
    // `client.stream` gives no way to read the status back. The message says so rather than
    // reporting an empty answer.
    fn a_stream_that_never_started_says_what_probably_happened(): void {
        probe: dyn StreamDecoder = AnthropicStream.new()
        match probe.finish() {
            Ok(u) => {
                assert(false, "an empty stream is not a reply: ${u}")
            },
            Err(e) => {
                assert("${e}".contains("message_start"), "${e}")
                assert("${e}".contains("status"), "the message names the reason it cannot tell: ${e}")
            },
        }
    }

    // An unmodeled *block* is refused, exactly as in the buffered decode — it carries answer
    // content, and dropping it turns a partial answer into a complete-looking one.
    fn an_unmodeled_streamed_block_is_refused(): void {
        frame = Frame {
            event: "content_block_start",
            data: "{\"type\":\"content_block_start\",\"index\":2,\"content_block\":{\"type\":\"server_tool_use\",\"id\":\"x\"}}",
            id: "",
            retry: none,
        }
        probe: dyn StreamDecoder = AnthropicStream.new()
        match probe.push(frame) {
            Ok(_) => {
                assert(false, "an unmodeled block must not be skipped")
            },
            Err(e) => {
                assert("${e}".contains("content[2].type"), "${e}")
                assert("${e}".contains("server_tool_use"), "${e}")
            },
        }
    }

    // An unmodeled *event*, by contrast, is skipped — the vendor documents that new event types
    // will appear and that a client should handle them gracefully. An envelope frame carries no
    // answer content, so skipping one loses nothing.
    fn an_unmodeled_event_is_skipped_where_an_unmodeled_block_is_not(): void {
        decoder: dyn StreamDecoder = AnthropicStream.new()
        frames = [
            Frame { event: "ping", data: "{\"type\": \"ping\"}", id: "", retry: none },
            Frame { event: "tomorrows_event", data: "{\"type\": \"tomorrows_event\", \"whatever\": 1}", id: "", retry: none },
        ]
        for f in frames {
            assert(decoder.push(f) == Ok([]), "${f.event} should decode to nothing at all")
        }
    }

    // The whole point of `decode_deltas`: the buffered door speaks the same vocabulary the
    // streaming door does, so everything downstream of it is one implementation.
    fn the_buffered_door_produces_deltas_too(): void {
        match Anthropic.new("k").decode_deltas(captured_text_reply()) {
            Ok(deltas) => {
                assert(deltas == [
                    Delta.ModelDelta(model: "claude-opus-5"),
                    Delta.TextDelta(id: "0", text: "Hej! Hur mår du?"),
                    Delta.Stop(reason: StopReason.EndTurn),
                    Delta.UsageDelta(usage: Usage {
                        input_tokens: 2095,
                        output_tokens: 503,
                        cached_input_tokens: 1024,
                    }),
                ], "${deltas}")
            },
            Err(e) => {
                assert(false, "${e}")
            },
        }
    }
}
