// `para.ai` — an agent harness for Noeta.
//
//     use para.ai.{Agent, AgentConfig}
//     use para.ai.providers.anthropic.Anthropic
//
//     agent = Agent.from(AgentConfig.new("claude-opus-5"), Anthropic.new(key))
//     echo agent.run_sync("Say hello in Swedish")?
//
// This module owns the data model (`Message`, `Part`, `Role`, `Conversation`), the run loop, and
// the error type. The codec seam is `para.ai.provider`; the vendors live under
// `para.ai.providers.*`; `para.ai.mock` is the hermetic test double.
//
// **The run loop is the only place with I/O.** A provider never performs a request — it encodes one
// and decodes the answer. Everything transport-shaped (retry with `Retry-After`, mocking,
// recording, caching, logging) is a `para/api` middleware, written once, outside this package.
//
// **Telemetry is not a module.** The run loop emits OpenTelemetry GenAI spans and metrics directly
// onto `std.tracing`/`std.metrics`, so it cannot be forgotten: nothing when no endpoint is set,
// everything when one is, and no configuration API of our own.
use std.http.client
use std.http.{Frame, Framing, FrameStream, HttpError, Request}
use std.task.{map_bounded, sleep}
// `uuid` by name, not `use std.id`: a whole-module import binds its last segment as a local, and
// `id` is what half the `Part` patterns in this file bind — the collision is not a check error but
// a runtime "cannot assign to `id`" from inside a `match` arm (AGENTS.md).
use std.id.uuid
use std.{env, metrics, time, tracing}
use para.api.Api
use para.api.middleware.Retry
use ai.provider.{Delta, ModelRequest, ModelReply, Provider, StopReason, StreamDecoder, Usage, Wire, fold}
// The `@prompt` tier's value types by name, for the same reason `uuid` is: a whole-module
// `use para.ai.prompt` would bind `prompt` as a local, and this file is full of bindings that want
// that word. Importing the types does **not** bring the tier into a consumer's file — a consumer
// writing `@prompt { … }` imports `para.ai.prompt.render` itself, which is the one line that
// declares the block syntax exists.
use ai.prompt.{Prompt, Resolved}
use ai.tools
use ai.tools.{Output, Toolbox, ToolSource}
// The guard vocabulary. `decide` comes in **by name** rather than through a whole-module
// `use para.ai.guard`: a whole-module import binds its last segment as a local, and `guard` is the
// field `Fired` and `Denial` both want (E0020, the same collision `provider` has in this file).
use ai.guard.{Fired, Guard, GuardCtx, OnDeny, Stage, Verdict, decide}
// The typed decode `extract` bottoms out in. `json.try_parse::<T>` is the recoverable door **and**
// the one that runs `Validate` — see `extract` for why that matters more than it looks.
use std.json
use std.json.JsonError

// --- The data model -------------------------------------------------------------------------------
//
// Every type here is a value `struct` or `enum`, never a `class`. That is not incidental: value
// types are `Send`, reference types are not, and a run's messages have to be able to cross a
// channel and an isolate boundary. `bytes` is `Send`, so inline images are fine.

pub enum Role {
    System
    User
    Assistant
    Tool
}

// One piece of a message. Covers what the major vendors can express between them; each codec is
// responsible for rejecting — loudly, at `encode` — what its own vendor cannot.
//
// Two of these are decisions rather than shapes:
//
//   * **`ToolCall.args` is a raw JSON string, not a decoded map.** Vendors stream tool arguments as
//     partial JSON fragments, so keeping the raw text puts the accumulate-then-decode boundary in
//     one place, and a malformed argument blob becomes a recoverable error with a path rather than
//     a half-built value.
//   * **`Thinking.signature` is round-tripped verbatim.** Anthropic requires the signature back on
//     the next turn for the block to remain valid; discarding it silently degrades multi-turn
//     reasoning. Nothing in para/ai interprets it.
@derive(Equatable, Display)
pub enum Part {
    Text(text: string)
    Image(mime: string, data: bytes)
    File(mime: string, name: string, data: bytes)
    ToolCall(id: string, name: string, args: string)
    ToolResult(id: string, content: string, is_error: bool)
    Thinking(text: string, signature: string)
}

// One turn of a conversation.
//
// `name` is the optional speaker name some vendors accept on a `user` turn (multi-participant
// chats); a codec whose vendor has no such field ignores it rather than failing, because a name is
// a hint and dropping it changes nothing about what was said.
@derive(Equatable, Display)
pub struct Message {
    pub role: Role
    pub parts: List<Part>
    pub name: ?string = none
    // "Everything up to and including this turn may be served from the vendor's prompt cache."
    //
    // A **hint**, exactly like `name`: a codec whose vendor has no explicit breakpoint (OpenAI and
    // Google cache implicitly, on an exact prefix match) ignores it and still produces a correct
    // request, while Anthropic's codec turns it into `cache_control` on this turn's last content
    // block. It sits on the message rather than on a `Part` because that is the granularity a
    // breakpoint is *placed* at — and `prompt_turns` gives a `@prompt`'s stable prefix a turn of
    // its own precisely so message granularity is enough.
    //
    // Defaulted to `false`, so nothing that builds a `Message` today changes, and meaningless on a
    // message that came *back* from a model — a reply is not a request.
    pub cache_breakpoint: bool = false

    fn system(text: string): Message {
        return Message { role: Role.System, parts: [Part.Text(text: text)] }
    }

    fn user(text: string): Message {
        return Message { role: Role.User, parts: [Part.Text(text: text)] }
    }

    fn assistant(text: string): Message {
        return Message { role: Role.Assistant, parts: [Part.Text(text: text)] }
    }

    // A tool's answer, addressed to the call it answers. `is_error: true` is how a failing tool is
    // reported back to the model — a failing tool is a turn, not an outage.
    fn tool(id: string, content: string, is_error: bool = false): Message {
        return Message {
            role: Role.Tool,
            parts: [Part.ToolResult(id: id, content: content, is_error: is_error)],
        }
    }

    // Every `Text` part, concatenated. The plain-string view of a turn — what a chat UI renders and
    // what `run_sync` hands back. Thinking, tool calls, and attachments are deliberately absent:
    // they are not what the message *said*.
    fn text(): string {
        mut out = ""
        for p in self.parts {
            out = out ~ match p {
                Part.Text(t) => t,
                _ => "",
            }
        }
        return out
    }

    // The same turn, marked as the end of a cacheable prefix. The hand door: `AgentConfig` marks
    // the system prompt's stable part for you, and this is how a caller marks a long stable context
    // turn of their own — a retrieved corpus, a code base, a transcript.
    fn cached(): Message {
        return Message { cache_breakpoint: true, ...self }
    }

    // Every tool call this message requests, in order. Empty unless the model asked for one.
    fn tool_calls(): List<Part> {
        mut out: List<Part> = []
        for p in self.parts {
            match p {
                Part.ToolCall(id, name, args) => {
                    out = out ~ [p]
                },
                _ => {},
            }
        }
        return out
    }
}

// The turns a resolved `@prompt` becomes — **the one place the language's split turns into wire
// shape**, and the reason this package can place a cache breakpoint that other frameworks cannot.
//
// A prompt with holes becomes *two* turns of the same role: its stable prefix, then its volatile
// tail. Two turns rather than one turn with two parts because a vendor's breakpoint attaches to a
// content block and the cached prefix ends where that block ends — so the stable text has to be a
// block of its own or the boundary lands in the wrong place. Codecs already merge adjacent turns of
// one wire role, so the split costs nothing on the wire: Anthropic sees two `system` blocks, an
// OpenAI-shaped codec sees one merged turn whose text is byte-identical to the unsplit version.
//
// `mark` places the breakpoint on the stable turn. It is skipped when there is nothing worth
// marking: a prompt whose first hole is at the start (or after nothing but whitespace) has no
// prefix to cache, and marking an empty content block is a vendor error rather than a free win.
//
// A prompt with **no** holes is one marked turn — the maximal prefix, which is the best case.
pub fn prompt_turns(role: Role, r: Resolved, mark: bool): List<Message> {
    stable = r.stable()
    volatile = r.volatile()
    if stable.trim() == "" {
        return [Message { role: role, parts: [Part.Text(text: stable ~ volatile)] }]
    }
    head = Message { role: role, parts: [Part.Text(text: stable)], cache_breakpoint: mark }
    if volatile == "" {
        return [head]
    }
    return [head, Message { role: role, parts: [Part.Text(text: volatile)] }]
}

// A conversation, as a value. Immutable: every builder returns a new `Conversation`, so a prefix
// can be shared across concurrent runs without any of them disturbing the others.
@derive(Equatable, Display)
pub struct Conversation {
    pub messages: List<Message> = []

    fn new(): Conversation {
        return Conversation {}
    }

    // The one-user-turn conversation — the shape behind `run_sync`.
    fn of(text: string): Conversation {
        return Conversation { messages: [Message.user(text)] }
    }

    fn with(m: Message): Conversation {
        return Conversation { messages: self.messages ~ [m] }
    }

    fn user(text: string): Conversation {
        return self.with(Message.user(text))
    }

    fn assistant(text: string): Conversation {
        return self.with(Message.assistant(text))
    }

    fn system(text: string): Conversation {
        return self.with(Message.system(text))
    }

    // Append a `@prompt { … }` block as a turn — the same door `with` is, for a value that arrived
    // with its stable/volatile boundary attached.
    //
    // The prompt is resolved **here**, once, so the turns are ordinary `Message` values from this
    // point on: a `Conversation` is `Send` and `Equatable`, and a list of thunks is neither.
    //
    // `cache` defaults to `false`, unlike `AgentConfig`'s system prompt. A conversation turn is not
    // reliably a prefix — the next `with` puts something after it — and every vendor caps how many
    // breakpoints one request may carry (Anthropic: four), so spending one on each interpolated
    // turn is the wrong default. Pass `true`, or `Message.cached()`, when the turn really is a long
    // stable prefix worth caching.
    fn with_prompt(role: Role, p: Prompt, cache: bool = false): Conversation {
        return Conversation { messages: self.messages ~ prompt_turns(role, p.resolve(), cache) }
    }

    fn system_prompt(p: Prompt, cache: bool = false): Conversation {
        return self.with_prompt(Role.System, p, cache)
    }

    fn user_prompt(p: Prompt, cache: bool = false): Conversation {
        return self.with_prompt(Role.User, p, cache)
    }

    fn last(): ?Message {
        return self.messages.last()
    }
}

// What a completed run produced: the whole conversation including the assistant's answer, the
// aggregate token usage, how many model calls it took, and why the model stopped.
@derive(Equatable, Display)
pub struct Run {
    pub messages: List<Message>
    pub usage: Usage = Usage {}
    pub turns: int = 0
    pub stop: StopReason = StopReason.EndTurn
    // Every non-`Allow` guard verdict this run produced, in the order they fired.
    //
    // **This is what makes "the guardrails are firing" observable without a metrics backend** —
    // `para.ai.guard.denials` and `para.ai.guard.rewrites` answer it in aggregate, and this answers
    // it for one run, which is what a test and a debugging session both need. The same distinction
    // `Cache.hits()` draws in para/api, and the reason DESIGN §9 names it.
    //
    // Defaulted, so nothing that builds a `Run` today changes. A run stopped *by* a guard returns
    // `AiError.Guard` instead and carries the stage, the guard and the reason there.
    pub verdicts: List<Fired> = []

    // The assistant's answer as plain text, or `""` if the run produced no assistant turn.
    fn text(): string {
        return match self.messages.last() {
            some(m) => m.text(),
            none => "",
        }
    }

    fn conversation(): Conversation {
        return Conversation { messages: self.messages }
    }
}

// --- Errors ---------------------------------------------------------------------------------------

// Everything that can go wrong in a run.
//
// A language constraint shapes this: **a type carries at most one `From` impl** (a second is a
// coherence conflict). So `AiError` declares `impl From<HttpError>` — the conversion that appears
// at the most `?` sites — and `JsonError` is mapped explicitly at its handful of decode points into
// `Decode(path, message)`, preserving the path. That is a decision, not an omission: the first
// contributor who reaches for a second `From` should know why it is not there.
//
// The `para/api` line holds here too: `Err` means the call failed, while an HTTP error *status*
// from a vendor is an answer — decoded into `Provider(status, code, message)` with the vendor's own
// typed error body, so `code == "rate_limit_error"` is matchable and nobody has to regex a message.
//
@derive(Error)
pub enum AiError {
    // The request never produced a response — the network broke.
    Transport(inner: HttpError)
    // The vendor answered with an error status and its own typed error body.
    Provider(status: int, code: string, message: string)
    // A codec cannot express something the request contains. Raised at `encode`, naming the part
    // and the provider, rather than silently dropping it.
    Encode(provider: string, message: string)
    // A response body did not decode. `path` is the path to the failing value, when there is one.
    Decode(path: string, message: string)
    // The model declined. Never a decode failure: conflating the two makes "the model declined"
    // look like "your schema is wrong", which sends people debugging the wrong thing.
    Refused(reason: string)
    // A tool failed in a way the model cannot be asked to recover from: an underivable schema, a
    // name collision across sources, a source that could not be listed. A tool that merely *fails*
    // is not this — it is a `ToolResult(is_error: true)` turn, and the model gets to try again.
    Tool(name: string, message: string)
    // An MCP **server** failed as a server: it would not start, it exited, it broke the protocol, it
    // was asked for a capability it never advertised, or its session ended. `server` is the source
    // name a `Toolbox` collision message would print (`mcp:memory`), and `code` is one of a fixed,
    // low-cardinality set (`spawn`, `server_exited`, `eof`, `timeout`, `protocol`, `capability`,
    // `http_status`, `session_expired`, `read_budget`, `closed`, `sampling`) so it is matchable and
    // safe as a metric attribute.
    //
    // A *tool* that fails on an MCP server is `Tool(name, message)`, exactly as a local one is —
    // the model gets a `ToolResult(is_error: true)` turn either way. This variant is the layer
    // underneath that: the thing the model cannot be asked to work around.
    Mcp(server: string, code: string, message: string)
    // The run asked for more model calls than `AgentConfig.max_turns` allows.
    //
    // An error rather than a truncated `Ok`: a run that stops mid-tool-loop has an assistant turn
    // whose last word was a tool call nobody answered, and handing that back as an answer is the
    // silent-truncation failure DESIGN §10 refuses for context strategies, for the same reason. The
    // `MaxTurns` *guard* of phase 5 is a different thing at a different layer — a policy a caller
    // opts into, reported as `Guard(...)`; this is the loop's own hard rail, which is always on.
    MaxTurns(turns: int)
    // The conversation does not fit the budget and no context strategy was configured to fit it.
    ContextOverflow(needed: int, budget: int)
    // A guard denied, and the run's `on_deny` policy said the run ends (DESIGN §9). `guard` is the
    // guard's own low-cardinality name, so it is safe as a metric attribute and recognizable in a
    // message; `reason` is the guard's own words, which under `OnDeny.Feedback` would have been the
    // correction turn instead.
    Guard(stage: Stage, guard: string, reason: string)
    // The run was cancelled at a suspension point.
    Cancelled

    impl Display {
        fn to_string(): string {
            return match self {
                AiError.Transport(inner) => "transport failed (${inner.kind()}): ${inner.message()}",
                AiError.Provider(status, code, message) => "provider error ${status} ${code}: ${message}",
                AiError.Encode(provider, message) => "${provider} cannot encode this request: ${message}",
                AiError.Decode(path, message) => if path == "" then "decode failed: ${message}" else "decode failed at ${path}: ${message}",
                AiError.Refused(reason) => "the model refused: ${reason}",
                AiError.Tool(name, message) => if name == "" then "tool call failed: ${message}" else "tool `${name}` failed: ${message}",
                AiError.Mcp(server, code, message) => "mcp server `${server}` failed (${code}): ${message}",
                AiError.MaxTurns(turns) => "the run reached its ${turns}-turn limit with the model still asking for tools — raise `AgentConfig.max_turns` if the task genuinely needs more",
                AiError.ContextOverflow(needed, budget) => "context overflow: ${needed} tokens needed, budget is ${budget} — configure a context strategy",
                AiError.Guard(stage, guard, reason) => "the `${guard}` guard denied at ${stage}: ${reason}",
                AiError.Cancelled => "cancelled",
            }
        }
    }

    impl From<HttpError> {
        fn from(e: HttpError): AiError {
            return AiError.Transport(inner: e)
        }
    }
}

// --- Configuration --------------------------------------------------------------------------------

// Everything about an agent except its provider and its transport.
//
// It is a plain value struct, so it is `Send`: this is the thing you hand to a worker or an isolate,
// which then builds its own `Agent` from it. An `Agent` itself is **not** `Send` — it holds an
// `Api`, whose middleware stack is a `List<dyn Middleware>` — and phases 2 and 5 add more `dyn`
// slots (tool sources, guards). Build the agent per worker; ship the config.
@derive(Equatable, Display)
pub struct AgentConfig {
    pub model: string
    // The system prompt, **kept split** rather than flattened to a string.
    //
    // A `Resolved` from `.with_system("…")` is one static and no holes; one from
    // `.with_system_prompt(@prompt { … })` remembers where the author's fixed text ends and the
    // interpolated part begins. That boundary is what `prompt_turns` turns into a cache breakpoint,
    // and it is the reason this field is not a `?string`: flatten it here and the information the
    // language handed us is gone before any codec can use it.
    //
    // Resolving at configuration time rather than per turn is deliberate. A run makes one model
    // call per turn and re-sends the system prompt on each; a hole re-evaluated per call could
    // produce different text each time, and the stable prefix would stop being byte-identical —
    // which is the *only* thing OpenAI's and Google's implicit prefix caching keys on.
    pub system: ?Resolved = none
    pub max_tokens: ?int = none
    pub temperature: ?float = none
    pub stop: List<string> = []
    // How many model calls one run may make. The tool loop is the only thing that continues it, so
    // this is what stops a model that keeps asking for tools from spending an afternoon and a
    // budget. Eight is enough for the multi-step tasks tools exist for and small enough that a loop
    // costs pennies to discover; exceeding it is `AiError.MaxTurns`, never a truncated answer.
    pub max_turns: int = 8
    // How many tool calls may be in flight at once. **Unbounded parallel dispatch is a good way to
    // get rate-limited by your own agent** — a model that asks for twelve web fetches should not
    // open twelve sockets — so `std.task.map_bounded` caps it here rather than in each tool.
    pub tool_concurrency: int = 4
    // Names the run's root span (`invoke_agent {name}`) and its `gen_ai.agent.name` attribute. Keep
    // it low-cardinality — it is a span attribute, not an identifier.
    pub name: string = "agent"
    // Whether `run` and `run_sync` stream the model call. `stream` streams regardless.
    //
    // **False by default, and that is a decision rather than an omission.** Streaming and buffering
    // share one run loop, one delta vocabulary, one accumulator, and one event emitter — but not
    // one transport, because a `FrameStream` cannot flow through the `para/api` onion (DESIGN O-4).
    // The buffered path is therefore the one `Retry`, `Cache`, `Record`, `Mock`, and `Logging`
    // cover, and defaulting to streaming would quietly take those away from every caller who never
    // asked for it. Turning it on is one builder call and the README states the trade.
    pub stream: bool = false
    // How many times a *streamed* call is retried before giving up.
    //
    // The streaming path owns its retry: `para/api`'s `Retry` middleware sits on the buffered path
    // only, because retrying means asking for the body again and a stream you have begun reading
    // cannot be asked twice. Two attempts after the first is the same shape `Retry` defaults to.
    pub stream_retries: int = 2
    // The first backoff between streamed attempts, in milliseconds; each further attempt doubles
    // it. Small, because a streamed call that failed at all failed at the head, which is fast.
    pub stream_backoff_ms: int = 500
    // Vendor-specific request-body keys, as raw JSON fragments, merged verbatim by the codec.
    // Documented as unchecked: this is the escape hatch for a knob the neutral model has not
    // grown yet, and a malformed fragment surfaces at `encode`.
    pub extra: Map<string, string> = {}
    // Whether the run loop marks the system prompt's stable prefix as a prompt-cache breakpoint.
    //
    // **True by default**, which is the whole claim of DESIGN §14: caching is correct by default
    // because the language handed us the split, and a default that has to be switched on is a
    // default nobody switches on. A system prompt is re-sent on every turn of a run, so the tool
    // loop repays the cache write on its second call; below a vendor's minimum cacheable length the
    // marker is simply ignored rather than charged for.
    //
    // Turn it off for a single-call workload with a large system prompt that is never repeated
    // inside the cache's TTL — that is the one shape where a cache *write* (Anthropic prices it at
    // 1.25× input) is a real cost with no return.
    pub cache: bool = true
    // What the run does when a guard denies (DESIGN §9).
    //
    // On the **config** rather than on the agent, where the guards themselves live, and the split is
    // the `Send` line: a `dyn Guard` cannot cross to a worker but a policy is a plain value, so the
    // thing you ship carries the decision and the thing you build locally carries the machinery.
    //
    // `Stop` by default. A guard that fired and was silently worked around is not a guard, and a
    // default that quietly continues would make every guardrail advisory unless its author noticed.
    pub on_deny: OnDeny = OnDeny.Stop

    fn new(model: string): AgentConfig {
        return AgentConfig { model: model }
    }

    // The system prompt as ordinary text. Unchanged for every existing caller: a plain string is a
    // prompt with no holes, so it is entirely stable and gets the maximal cache prefix.
    fn with_system(text: string): AgentConfig {
        return AgentConfig { system: some(Resolved.of(text)), ...self }
    }

    // The system prompt as a `@prompt { … }` block — the door that carries the split.
    //
    // A separate method rather than an overload of `with_system`, and not for want of trying: a
    // `trait IntoPrompt` with an `impl … for string` is **E0013** (`cannot implement a trait for
    // `string`: it is not a record, class, or enum declared in this module`), so no bound can span
    // the two. Two named doors that agree on one representation beat a `dyn` parameter that agrees
    // on nothing the checker can see.
    fn with_system_prompt(p: Prompt): AgentConfig {
        return AgentConfig { system: some(p.resolve()), ...self }
    }

    // The system prompt flattened back to text, for a caller that only wants to read it. The split
    // is on `system` itself when the boundary matters.
    fn system_text(): ?string {
        return match self.system {
            some(r) => some(r.text()),
            none => none,
        }
    }

    fn with_max_tokens(n: int): AgentConfig {
        return AgentConfig { max_tokens: some(n), ...self }
    }

    fn with_temperature(t: float): AgentConfig {
        return AgentConfig { temperature: some(t), ...self }
    }

    fn with_stop(stop: List<string>): AgentConfig {
        return AgentConfig { stop: stop, ...self }
    }

    fn with_max_turns(n: int): AgentConfig {
        return AgentConfig { max_turns: n, ...self }
    }

    fn with_tool_concurrency(n: int): AgentConfig {
        return AgentConfig { tool_concurrency: n, ...self }
    }

    fn named(name: string): AgentConfig {
        return AgentConfig { name: name, ...self }
    }

    fn with_extra(key: string, json_fragment: string): AgentConfig {
        return AgentConfig { extra: self.extra.set(key, json_fragment), ...self }
    }

    // Stream every model call, including the ones `run` and `run_sync` make. See `stream` above for
    // what this costs: the `para/api` layers do not cover the streaming path.
    fn streamed(): AgentConfig {
        return AgentConfig { stream: true, ...self }
    }

    // Buffer every model call — the default, spelled out for a caller switching back.
    fn buffered(): AgentConfig {
        return AgentConfig { stream: false, ...self }
    }

    fn with_stream_retries(n: int): AgentConfig {
        return AgentConfig { stream_retries: n, ...self }
    }

    fn with_stream_backoff(ms: int): AgentConfig {
        return AgentConfig { stream_backoff_ms: ms, ...self }
    }

    // Mark the system prompt's stable prefix for the vendor's prompt cache — the default, spelled
    // out for a caller switching back.
    fn cached(): AgentConfig {
        return AgentConfig { cache: true, ...self }
    }

    // Send no cache breakpoint at all. The stable text is still first and still byte-identical, so
    // a vendor that caches implicitly keeps doing so; only the explicit marker goes away.
    fn uncached(): AgentConfig {
        return AgentConfig { cache: false, ...self }
    }

    // What a denied run does. `OnDeny.Stop` is the default; `Feedback(max)` hands the reason back to
    // the model, and `Replace(parts)` swaps in a canned reply.
    fn denying(policy: OnDeny): AgentConfig {
        return AgentConfig { on_deny: policy, ...self }
    }
}

// --- Events ---------------------------------------------------------------------------------------

// One thing that happened during a run, as it happened.
//
// **Every variant is a value type**, so a `Sender<Event>` works across tasks *and* isolates and the
// whole thing composes with parallel serving. The shape is chosen so that AG-UI encoding is a pure
// mapping rather than a translation layer — which is also why the enum is complete here rather than
// growing a variant at a time: adding one later would break every exhaustive `match` a consumer had
// written against it.
//
// **And it held.** `para.ai.agui.encode` is total, variant-local, and stateless: one event in, one
// frame out, no accumulator and no lookahead. The one place it came under pressure is
// `ThinkingDelta`, which AG-UI would normally bracket with four events of its own; the protocol's
// self-delimiting chunk form absorbs that, so nothing here had to change. DESIGN §11.2 records it,
// because if that form ever goes away this enum needs `ThinkingStart`/`ThinkingEnd` rather than the
// encoder needing state.
//
// **What the run loop emits** is `RunStarted`, the text / thinking / tool-call deltas with their
// block starts and ends, one `ToolCallResult` per dispatched call, and exactly one terminal
// `RunFinished` or `RunError`. `StateSnapshot`, `StateDelta`, `StepStarted`, `StepFinished`, and
// `Custom` are for consumers to produce — AG-UI encodes every one of them, and the loop has no
// opinion about what a step or a piece of state is.
@derive(Equatable, Display)
pub enum Event {
    RunStarted(run_id: string, thread_id: string)
    TextStart(id: string)
    TextDelta(id: string, delta: string)
    TextEnd(id: string)
    ThinkingDelta(id: string, delta: string)
    ToolCallStart(id: string, name: string)
    ToolCallArgsDelta(id: string, delta: string)
    ToolCallEnd(id: string)
    ToolCallResult(id: string, content: string, is_error: bool)
    StateSnapshot(json: string)
    StateDelta(patch: string)
    StepStarted(name: string)
    StepFinished(name: string)
    RunFinished(run_id: string, usage: Usage)
    RunError(message: string, code: string)
    Custom(name: string, json: string)
}

// The block the event stream currently has open, so that a `TextStart` is matched by exactly one
// `TextEnd` and a `ToolCallStart` by exactly one `ToolCallEnd`. `kind` is `""` when none is open.
//
// This mirrors `provider.fold`'s own block bookkeeping deliberately. The events and the accumulated
// message have to agree about where one block stops and the next begins, and the way to guarantee
// that is for both to open a new block on the same condition — a change of `(id, kind)`.
@derive(Equatable, Display)
pub struct Open {
    pub kind: string = ""
    pub id: string = ""
}

// The events that close whatever block is open, if any.
pub fn closing(open: Open): List<Event> {
    if open.kind == "text" {
        return [Event.TextEnd(id: open.id)]
    }
    if open.kind == "tool" {
        return [Event.ToolCallEnd(id: open.id)]
    }
    // A thinking block has no start or end in the event vocabulary — it gets a delta and nothing
    // else — so there is nothing to close.
    return []
}

// Move to block `(kind, id)`, closing whatever was open first. Returns the new state and the events
// the transition produced.
fn enter(open: Open, kind: string, id: string, opening: List<Event>): (Open, List<Event>) {
    if open.kind == kind && open.id == id {
        return (open, [])
    }
    return (Open { kind: kind, id: id }, closing(open) ~ opening)
}

fn text_step(open: Open, id: string, text: string): (Open, List<Event>) {
    (next, opened) = enter(open, "text", id, [Event.TextStart(id: id)])
    return (next, opened ~ [Event.TextDelta(id: id, delta: text)])
}

fn thinking_step(open: Open, id: string, text: string): (Open, List<Event>) {
    (next, opened) = enter(open, "thinking", id, [])
    return (next, opened ~ [Event.ThinkingDelta(id: id, delta: text)])
}

// A tool block is normally opened by a `ToolCallStart`. If arguments arrive for one that is not
// open, the block is opened here with an empty name rather than the fragment being dropped — a
// codec that streams fragments before naming the tool is odd, but losing arguments is worse.
fn args_step(open: Open, id: string, fragment: string): (Open, List<Event>) {
    (next, opened) = enter(open, "tool", id, [Event.ToolCallStart(id: id, name: "")])
    return (next, opened ~ [Event.ToolCallArgsDelta(id: id, delta: fragment)])
}

// One delta, as the events it means and the block state that follows it.
//
// Pure and total, and the single place where "these increments look like *that* to a consumer" is
// decided. It is also the reason a buffered run and a streamed run of the same reply produce the
// same event sequence: there is one implementation, and the transport chooses only how many deltas
// arrive at a time — never what they mean.
//
// `Stop`, `UsageDelta`, and `ModelDelta` produce no event. They are the run's *result*, and they
// surface in the terminal `RunFinished` rather than as increments of a block.
pub fn step(open: Open, d: Delta): (Open, List<Event>) {
    return match d {
        Delta.TextDelta(id, text) => text_step(open, id, text),
        Delta.ThinkingDelta(id, text) => thinking_step(open, id, text),
        Delta.ThinkingSignature(id, signature) => enter(open, "thinking", id, []),
        Delta.ToolCallStart(id, name) => enter(open, "tool", id, [Event.ToolCallStart(id: id, name: name)]),
        Delta.ToolCallArgs(id, fragment) => args_step(open, id, fragment),
        Delta.Stop(reason) => (open, []),
        Delta.UsageDelta(usage) => (open, []),
        Delta.ModelDelta(model) => (open, []),
    }
}

// A whole delta list as the events it means, blocks closed. The batch form of `step`, which is what
// the buffered path uses — its deltas all exist at once, so its events do too.
pub fn events_of(deltas: List<Delta>): List<Event> {
    mut open = Open {}
    mut out: List<Event> = []
    for d in deltas {
        (next, evs) = step(open, d)
        open = next
        out = out ~ evs
    }
    return out ~ closing(open)
}

// --- Where events go --------------------------------------------------------------------------------

// The consumer of a run's events.
//
// `async` because the channel case is: `Sender.send` applies backpressure end to end, which is the
// behavior you want — a slow renderer should slow the run down rather than grow memory. A sink that
// cannot suspend simply never awaits.
pub trait EventSink {
    async fn emit(e: Event): void
}

// Drops everything.
//
// What `run` and `run_sync` use — and the reason they are the same run as `stream`. The loop
// produces the identical events whichever door was called; only the consumer differs. That makes
// "a buffered run and a streamed run agree" a claim a test can check rather than an aspiration.
pub struct Silent {
    impl EventSink {
        async fn emit(e: Event): void {}
    }
}

// Sends every event down a channel, and lets the channel's backpressure reach the run.
pub struct Channel {
    pub tx: Sender<Event>

    impl EventSink {
        async fn emit(e: Event): void {
            self.tx.send(e).await
        }
    }
}

// --- Where streamed frames come from ------------------------------------------------------------

// A streamed response body, as the run loop reads it. The shape `Receiver`, `Socket`, and
// `FrameStream` already share in std: await the next one, `none` when the body ends.
pub trait Frames {
    async fn next(): ?Frame
    fn close(): void
}
// Release the connection. Called on every path out of the read loop, including the failing
// ones — a stream abandoned mid-body otherwise holds a socket open until the process exits.

// Where a streamed request's frames come from.
//
// **This seam exists because of DESIGN O-4.** `client.stream` returns a `FrameStream`, and that is
// a type the `para/api` onion structurally cannot accept: `Retry` calls `next` again and a second
// call means a second body, `Cache` and `Record` would have to store one, and `Mock` answers with a
// whole buffered `Response`. So the streaming path cannot reach the transport the buffered path
// reaches, and `Mock` cannot double as the streaming transport the way it does for the buffered
// one. One trait with two implementations — the real client, and a scripted replay — is what keeps
// a streaming test as hermetic as a buffered one.
pub trait Streamer {
    fn open(req: Request, framing: Framing): Result<dyn Frames, AiError>
}

// The real thing: `std.http.client.stream` sends the request, reads the response head, and hands
// back a reader over the body.
//
// **It cannot see the response status**, and that is a real limitation rather than an oversight
// here: `FrameStream` exposes `recv` and `close` and nothing else, so a 429 arrives as a body that
// frames into nothing instead of as `AiError.Provider(429, "rate_limit_error", …)`. Each codec's
// `StreamDecoder.finish` says so in its message; see the README.
pub struct HttpStreamer {
    impl Streamer {
        fn open(req: Request, framing: Framing): Result<dyn Frames, AiError> {
            return Ok(LiveFrames { stream: client.stream(req, framing)? })
        }
    }
}

struct LiveFrames {
    stream: FrameStream

    impl Frames {
        async fn next(): ?Frame {
            return self.stream.recv().await
        }

        fn close(): void {
            self.stream.close()
        }
    }
}

// --- Telemetry ------------------------------------------------------------------------------------
//
// The OpenTelemetry GenAI semantic conventions, emitted from the run loop itself. Three commitments:
//
//   * **Message content is off by default.** Prompts and completions in spans are a privacy and
//     compliance hazard. Opt in with `OTEL_GENAI_CAPTURE_MESSAGES=true`, matching the OTel
//     convention rather than inventing a knob.
//   * **No high-cardinality metric attributes.** No user ids, no thread ids, no prompt text — every
//     distinct attribute set is a stored series, and an agent is exactly the workload that would
//     blow that up.
//   * **The semconv version is pinned and stated** — in the README, next to the attribute table.

fn capture_messages(): bool {
    v = (env.get("OTEL_GENAI_CAPTURE_MESSAGES") ?? "").lower()
    return v == "true" || v == "1"
}

fn token_usage_histogram(): dyn {
    return metrics.histogram("gen_ai.client.token.usage")
}

fn operation_duration_histogram(): dyn {
    return metrics.histogram("gen_ai.client.operation.duration")
}

// --- Guardrails, where they attach to the loop ------------------------------------------------------
//
// The trait, the verdicts, the stages and the nine standard guards are all in `para.ai.guard`, which
// knows nothing about the run loop. What is here is the other half: the four points a guard is
// consulted at, and what `AgentConfig.on_deny` does with a `Deny` at each of them.

// One denial, flattened out of a `Decision` so the loop can carry it without re-matching.
@derive(Equatable, Display)
struct Denial {
    stage: Stage
    guard: string
    reason: string
}

// One stage's outcome: the content to carry on with — rewritten, or exactly what went in — plus the
// verdicts that fired and the denial that stopped the stage, if one did.
@derive(Equatable, Display)
struct Gated {
    parts: List<Part>
    fired: List<Fired> = []
    denial: ?Denial = none
}

// The tool calls that survived `Stage.ToolCall`, and the results standing in for the ones that did
// not. Two lists rather than one because only the first is dispatched, and the canned results have
// to land in the same tool turn as the real ones — a `ToolCall` separated from its `ToolResult` is
// a conversation every vendor rejects (DESIGN §10).
@derive(Equatable, Display)
struct Approved {
    approved: List<Part>
    canned: List<Part>
}

// Consult one stage and normalize the answer. The single place a `Verdict` is turned into something
// the loop acts on, so no stage can interpret one differently from another.
fn gate(guards: List<dyn Guard>, stage: Stage, ctx: GuardCtx): Gated {
    d = decide(guards, stage, ctx)
    return match d.verdict {
        Verdict.Allow => Gated { parts: ctx.parts },
        Verdict.Rewrite(parts) => Gated {
            parts: parts,
            fired: [Fired { stage: stage, guard: d.guard, verdict: d.verdict }],
        },
        Verdict.Deny(reason) => Gated {
            parts: ctx.parts,
            fired: [Fired { stage: stage, guard: d.guard, verdict: d.verdict }],
            denial: some(Denial { stage: stage, guard: d.guard, reason: reason }),
        },
    }
}

fn guard_error(d: Denial): AiError {
    return AiError.Guard(stage: d.stage, guard: d.guard, reason: d.reason)
}

// What a denied **input** turn produces. `Replace` is the one policy with a real answer here — the
// canned reply, returned as a successful run — because nothing has been sent yet and there is
// nobody to give feedback to. `Feedback` therefore reads as `Stop`, which the `OnDeny` doc states.
fn input_denied(policy: OnDeny, conv: Conversation, d: Denial, fired: List<Fired>, turn: int): Result<Run, AiError> {
    return match policy {
        OnDeny.Replace(parts) => Ok(Run {
            messages: conv.with(Message { role: Role.Assistant, parts: parts }).messages,
            turns: turn,
            stop: StopReason.EndTurn,
            verdicts: fired,
        }),
        _ => Err(guard_error(d)),
    }
}

// The conversation with its trailing turn of `role` rewritten. A guard rewrote the content, and the
// content has to reach the model — writing it back into the message it came from is what makes
// `Recall`'s prepended memories part of the turn rather than an addition nobody carries.
fn with_rewritten_tail(conv: Conversation, role: Role, parts: List<Part>): Conversation {
    at = last_index_of_role(conv, role)
    if at < 0 {
        return conv
    }
    before = conv.messages[at]
    if before.parts == parts {
        return conv
    }
    return Conversation { messages: conv.messages.set(at, Message { parts: parts, ...before }) }
}

fn last_index_of_role(conv: Conversation, role: Role): int {
    mut at = -1
    for (i, m) in conv.messages.enumerate() {
        if m.role == role {
            at = i
        }
    }
    return at
}

// The `GuardCtx` for each stage. Built here rather than by each guard, so every guard sees the same
// shape and a new stage cannot quietly show one of them less than another.
fn input_ctx(conv: Conversation, run_id: string): GuardCtx {
    at = last_index_of_role(conv, Role.User)
    empty: List<Part> = []
    return GuardCtx {
        stage: Stage.Input,
        run_id: run_id,
        turn: 0,
        parts: if at < 0 then empty else conv.messages[at].parts,
        conversation: conv,
    }
}

fn turn_ctx(stage: Stage, conv: Conversation, run_id: string, turn: int, usage: Usage, parts: List<Part>): GuardCtx {
    return GuardCtx {
        stage: stage,
        run_id: run_id,
        turn: turn,
        parts: parts,
        conversation: conv,
        input_tokens: usage.input_tokens,
        output_tokens: usage.output_tokens,
    }
}

fn call_ctx(conv: Conversation, run_id: string, turn: int, usage: Usage, call: Part): GuardCtx {
    (name, args) = call_parts(call)
    return GuardCtx {
        stage: Stage.ToolCall,
        run_id: run_id,
        turn: turn,
        parts: [call],
        conversation: conv,
        tool: name,
        args: args,
        input_tokens: usage.input_tokens,
        output_tokens: usage.output_tokens,
    }
}

fn call_parts(call: Part): (string, string) {
    return match call {
        Part.ToolCall(id, name, args) => (name, args),
        _ => ("", ""),
    }
}

// A refused call, as the failed tool result the model reads. It keeps the call's own id, because a
// result that does not address its call is a conversation every vendor rejects.
fn refusal_result(call: Part, reason: string): Part {
    return match call {
        Part.ToolCall(id, name, args) => Part.ToolResult(id: id, content: reason, is_error: true),
        _ => Part.ToolResult(id: "", content: reason, is_error: true),
    }
}

// Every tool result in a turn, marked failed and carrying one reason. What a denied `ToolResult`
// stage produces under a policy that continues: the model is told its tool's answer was withheld,
// which it can act on, rather than being handed content a guard rejected.
fn errored(results: List<Part>, reason: string): List<Part> {
    mut out: List<Part> = []
    for p in results {
        out = out ~ [match p {
            Part.ToolResult(id, content, is_error) => Part.ToolResult(id: id, content: reason, is_error: true),
            _ => p,
        }]
    }
    return out
}

// The turn's results, back in the order the model asked for them.
//
// **A guard splits one tool turn into two lists and the split loses the order.** `gate_calls` sorts
// the requested calls into the approved ones (which go to `dispatch`, and come back in *their* own
// order) and the denied ones (which are answered on the spot), so concatenating the two puts every
// refusal in front of every answer — a model that asked for `find_order` and then `open_refund` is
// handed the refusal first. `dispatch` is careful to preserve per-item order precisely because a
// result list that does not follow its call list is hard to read and harder to debug, and a guard
// must not be the thing that undoes that.
//
// Matched on the call id rather than by position, because that is the identity a result carries and
// the one every vendor addresses it by. Anything unmatched — which nothing in this package produces
// — is appended rather than dropped: a lost result is a call the model never hears back about, and
// several vendors reject the whole request for it.
fn in_call_order(calls: List<Part>, results: List<Part>): List<Part> {
    mut out: List<Part> = []
    mut placed: List<string> = []
    for c in calls {
        id = call_id(c)
        if id != "" {
            for r in results {
                if result_id(r) == id {
                    out = out ~ [r]
                    placed = placed ~ [id]
                }
            }
        }
    }
    for r in results {
        if !placed.contains(result_id(r)) {
            out = out ~ [r]
        }
    }
    return out
}

fn result_id(p: Part): string {
    return match p {
        Part.ToolResult(id, content, is_error) => id,
        _ => "",
    }
}

fn call_id(p: Part): string {
    return match p {
        Part.ToolCall(id, name, args) => id,
        _ => "",
    }
}

fn text_of(parts: List<Part>): string {
    mut out = ""
    for p in parts {
        out = out ~ match p {
            Part.Text(t) => t,
            _ => "",
        }
    }
    return out
}

// --- Structured responses -------------------------------------------------------------------------
//
// DESIGN §8: ask for a type, get a type.
//
//     @derive(Deserialize<Json>)
//     struct Extraction {
//         company: string
//         confidence: float
//
//         impl Validate {
//             fn validate(): Result<void, string> {
//                 if self.confidence < 0.0 || self.confidence > 1.0 {
//                     return Err("confidence out of range: ${self.confidence}")
//                 }
//                 return Ok()
//             }
//         }
//     }
//
//     out = Output.of::<Extraction>()?
//     e   = extract::<Extraction>(agent, conv, out)?
//
// **The best output guardrail is already in the language, and para/ai does not implement it.**
// `json.try_parse::<T>` runs `Validate` automatically, bottom-up, at the decode door — so a
// structured reply is validated before this package ever sees the value, and the failure arrives as
// a path-carrying `JsonError` reading `items[2]: confidence out of range: 1.4`. That message is
// also an excellent repair prompt, which is exactly what `extract` does with it.

// One structured model call — the provider-erased seam `extract` drives. `Agent<P>` implements it
// inline; the comment on that impl says why the erasure is load-bearing rather than tidy.
pub trait Structured {
    fn ask_json(conv: Conversation, out: Output): Result<string, AiError>
}
// Ask for one document in `out`'s shape, and hand back its raw JSON text.
//
// Synchronous, like `ToolSource.call` and for the same reason: it is held as `dyn`. That also
// makes `extract` callable from a plain `fn`, which is what keeps its tests real — an `async fn`
// in a `@test` block is never driven on a released toolchain, so an async extraction's
// assertions would be vacuous exactly where they matter most.

// Ask for a value of type `T`, and get one — or a typed error saying why not.
//
// **A top-level function rather than `agent.extract::<T>(conv)`**, which DESIGN §8.1 sketches and no
// spelling of this language can provide: a generic method cannot forward its parameter into
// `json.try_parse::<T>` (E0058, measured), and a turbofish must name every parameter of the function
// it instantiates, so the provider is erased behind `dyn Structured` to leave exactly one. The
// argument order still reads left to right as "extract this, from that agent, over this
// conversation, in this shape".
//
// **Bounded repair** (§8.3). On a decode or validation failure the `JsonError`'s own message goes
// back as a correction turn and the call is made again, `repair` times, defaulting to 1. One repair
// fixes the overwhelming majority of real failures; an unbounded loop against a model that has
// misunderstood the schema is a way to spend money. Every attempt is a span event, so a run that
// repaired shows it in the trace instead of hiding it in latency.
//
// **A refusal is not a decode failure** (§8.4). `StopReason.Refusal` has already become
// `AiError.Refused` inside the run loop, and it comes back out of here unchanged and unretried —
// repairing a refusal would spend the budget arguing with a model that declined on purpose, and
// reporting it as a `JsonError` would send the reader to debug a schema that is fine.
//
// **A repair that gives up returns a typed error, not a half-built value** (§10's rule, which
// applies here too). The last failure is reported with its path intact.
pub fn extract<T>(a: dyn Structured, conv: Conversation, out: Output, repair: int = 1): Result<T, AiError> {
    budget = at_least(repair, 0)
    span = tracing.span("extract ${out.name}")
    span.set_attribute("gen_ai.operation.name", "extract")
    span.set_attribute("para.ai.output.type", out.target)
    span.set_attribute("para.ai.output.repair_budget", budget)

    mut so_far = conv
    mut attempt = 0
    mut outcome: Result<T, AiError> = no_attempt(out)
    mut settled = false
    while !settled && attempt <= budget {
        if attempt > 0 {
            // The trace is where a repair belongs. A run that quietly costs two model calls instead
            // of one is a cost nobody can see until the invoice arrives.
            span.add_event("para.ai.output.repair")
        }
        match a.ask_json(so_far, out) {
            Ok(text) => {
                // The one decode, and the one place `Validate` runs. Nothing in this package
                // inspects the document first: a pre-check would be a second, weaker copy of a
                // validation the language already performs completely.
                match json.try_parse::<T>(text) {
                    Ok(value) => {
                        outcome = decoded(value)
                        settled = true
                    },
                    Err(e) => {
                        outcome = undecoded::<T>(out, e)
                        so_far = so_far.assistant(text).user(correction(e))
                    },
                }
            },
            Err(e) => {
                // A refusal, a transport failure, a vendor error: none of them is a malformed
                // document, and none of them is repaired by telling the model its JSON was wrong.
                outcome = failed::<T>(e)
                settled = true
            },
        }
        attempt = attempt + 1
    }
    span.set_attribute("para.ai.output.attempts", attempt)
    match outcome {
        Ok(v) => {},
        Err(e) => {
            span.record_error("${e}")
        },
    }
    span.end()
    return outcome
}

// The three `Result` constructors `extract` assigns through.
//
// Written as functions with declared return types because a bare `Ok(v)`/`Err(e)` assigned to an
// already-annotated `mut` is E0023 — the declaration's annotation is not consulted for the
// assignment's expected type, and the diagnostic's help suggests the annotation that is already
// there. The same workaround `mcp.noe` uses, and for the same reason (AGENTS.md).
//
// The two **return-only** ones are called `failed::<T>(e)` rather than `failed(e)`, and the
// turbofish is required rather than decorative: expected-type seeding fills a return-only parameter
// from an *annotation* (`no_attempt(out)` in the initializer infers fine) but not from a
// **reassignment**, which reports `cannot assign Result<dyn, AiError> to outcome`. Forwarding the
// enclosing `T` into a user generic's turbofish is what closes it — a capability the name-keyed
// reflection turbofishes deliberately do not have, and the difference is worth knowing.
fn decoded<T>(v: T): Result<T, AiError> {
    return Ok(v)
}

fn failed<T>(e: AiError): Result<T, AiError> {
    return Err(e)
}

// A decode or validation failure, with the path the language handed us kept intact. `path` is what
// makes `items[2].confidence` a location rather than a paragraph, and flattening it into the message
// would throw away the only part a program can branch on.
fn undecoded<T>(out: Output, e: JsonError): Result<T, AiError> {
    return Err(AiError.Decode(path: e.path(), message: "`${out.target}`: ${e.message()}"))
}

fn no_attempt<T>(out: Output): Result<T, AiError> {
    return Err(AiError.Decode(
        path: "",
        message: "`${out.target}`: no extraction attempt was made — the repair budget was negative",
    ))
}

// The correction turn a failed decode becomes.
//
// It is the `JsonError`'s own message and nothing else, because that message is already the best
// prompt available: `Validate` runs bottom-up at the door, so a nested failure arrives as
// `items[2]: confidence out of range: 1.4` — the field, its path, and the invariant it broke, in the
// words the type's author wrote. Paraphrasing it here would lose the path and add nothing.
fn correction(e: JsonError): string {
    return "That did not decode: ${e.message()}. Answer again with the same schema, correcting exactly that."
}

// The document a structured run produced, from wherever this vendor put it.
//
// Two places, because the vendors genuinely differ: OpenAI, Google and Ollama constrain the ordinary
// assistant text, while Anthropic forces a tool and the document arrives as that call's arguments.
// The tool call is checked first and by name, so an agent that also has real tools cannot have one
// of *their* calls mistaken for the answer.
fn structured_json(run: Run, out: Output): Result<string, AiError> {
    last = run.conversation().last()
    match last {
        some(m) => {
            for p in m.parts {
                match p {
                    Part.ToolCall(id, name, args) => {
                        if name == out.name {
                            return Ok(args)
                        }
                    },
                    _ => {},
                }
            }
            text = m.text().trim()
            if text != "" {
                return Ok(text)
            }
        },
        none => {},
    }
    // Empty is its own failure, and a different one from malformed. A vendor that answered with
    // nothing at all did not produce a document with a bad field in it, and reporting it as a
    // decode failure would send the reader looking for a schema mistake.
    return Err(AiError.Decode(
        path: "",
        message: "`${out.target}`: the reply carried no `${out.name}` tool call and no text — the model was asked for a structured answer and produced nothing to decode",
    ))
}

// The tool calls the loop should actually dispatch: every one that is not this run's output tool.
fn dispatchable_calls(calls: List<Part>, output: ?Output): List<Part> {
    name = match output {
        some(out) => out.name,
        none => "",
    }
    if name == "" {
        return calls
    }
    mut out: List<Part> = []
    for p in calls {
        match p {
            Part.ToolCall(id, called, args) => {
                if called != name {
                    out = out ~ [p]
                }
            },
            _ => {},
        }
    }
    return out
}

// --- The agent ------------------------------------------------------------------------------------

// An agent: a configuration, a provider codec, and the transport chain to send through.
//
// `P` is a **bound**, not a trait object. That buys three things over `dyn Provider`: the codec
// stays a value type, dispatch is static, and the bound types the body — a wrong argument or return
// against a `Provider` method is a check-time error at this definition, before any call site
// exists. The cost is real and accepted: a bound pins the provider in the type, so
// `match env.get("AI_PROVIDER") { … }` cannot produce one `Agent` value. Runtime selection is the
// caller's `match`, pushed to the outermost point where the arms still agree — which works because
// `run`/`run_sync` return provider-independent types. The README leads with that pattern so nobody
// discovers the constraint by hitting a type error.
// A populated `toolbox` holds `List<dyn ToolSource>`, so an agent with tools is `!Send` — the same
// trade `api`'s middleware stack already makes. Ship the `AgentConfig`, build the `Agent` per
// worker.
pub struct Agent<P: Provider> {
    pub config: AgentConfig
    pub provider: P
    pub api: Api
    // Where a *streamed* call's frames come from. A second transport slot rather than a second
    // middleware, because a streaming body cannot go through `api` at all (DESIGN O-4) — see
    // `Streamer`. Defaults to the real client; `frames` swaps in a scripted replay.
    pub transport: dyn Streamer
    pub toolbox: Toolbox = Toolbox.new()
    // The shape this agent's next reply must take, when one was asked for.
    //
    // On the `Agent` rather than on `AgentConfig` because it is a **per-call** decision, not a
    // standing one: the same agent answers `run_sync` with prose and `extract` with a document, and
    // a config field would make "which of my agents is the structured one" a thing to keep track of.
    // `expecting` returns a new agent, so nothing is mutated and a structured call cannot leak into
    // the next ordinary one.
    pub output: ?Output = none
    // The guards this agent consults, in registration order (DESIGN §9).
    //
    // A `List<dyn Guard>` for the same reason the toolbox holds `List<dyn ToolSource>`: a guard is
    // an ordinary Noeta value and none is privileged, so the only thing they have in common is the
    // trait. It also means an agent with guards is `!Send`, which is the trade `dyn` always is —
    // ship the `AgentConfig`, build the agent per worker.
    pub guards: List<dyn Guard> = []

    // An agent over the default transport: a plain client wrapped in `Retry`, which honors a
    // vendor's `Retry-After` and backs off on 429/502/503/504. `retry(0)` on the client is
    // deliberate and load-bearing — std's own retry lives *inside* `send`, beneath every
    // middleware, and leaving both on multiplies the attempts.
    fn from(cfg: AgentConfig, p: P): Agent<P> {
        return Agent.over(cfg, p, Api.new(client.new().retry(0)).with(Retry.new()))
    }

    // An agent over a transport chain you composed yourself — the door for `Mock`, `Record`,
    // `Cache`, a custom auth layer, or a client with a different timeout.
    fn over(cfg: AgentConfig, p: P, api: Api): Agent<P> {
        return Agent { config: cfg, provider: p, api: api, transport: HttpStreamer {} }
    }

    // Read streamed frames from somewhere other than the network — the door `Mock` uses, and the
    // one a recorded-transcript fixture would. The buffered half still goes through `api`.
    fn frames(src: dyn Streamer): Agent<P> {
        return Agent { transport: src, ...self }
    }

    // Give the agent a source of tools.
    //
    // **A `Result`, where DESIGN §6's sketch is not.** Adding a source derives every schema and
    // checks every name against what is already there, and both can fail — a name collision across
    // sources is a construction-time error naming both, never a last-one-wins. Chains:
    // `Agent.from(cfg, p).tools(Local.new())?.tools(mcp)?`.
    fn tools(src: dyn ToolSource): Result<Agent<P>, AiError> {
        grown = self.toolbox.with(src)?
        return Ok(Agent { toolbox: grown, ...self })
    }

    // Attach a `Toolbox` you assembled yourself — the infallible door, for a caller that would
    // rather handle the collision error once at construction than at each `tools` call.
    fn with_toolbox(box: Toolbox): Agent<P> {
        return Agent { toolbox: box, ...self }
    }

    // The same agent, asked to answer in a declared shape. `extract` uses this; a caller who wants
    // the raw document rather than a typed value can use it directly and read `Run.text()`.
    fn expecting(out: Output): Agent<P> {
        return Agent { output: some(out), ...self }
    }

    // Register a guard. Chains, and the **order is the order they are consulted in** — the first
    // non-`Allow` verdict wins, so a cheap structural check belongs before an expensive judgement.
    //
    // On the `Agent` rather than on `AgentConfig` for the same reason the toolbox is: a `dyn Guard`
    // is not `Send`, and `AgentConfig` is the value you ship to a worker. Build the guards per
    // worker; ship the config, which carries the `on_deny` *policy* because a policy is a plain
    // value.
    fn with(g: dyn Guard): Agent<P> {
        return Agent { guards: self.guards ~ [g], ...self }
    }

    // Consult `Stage.ToolCall` for each requested call, keeping the approved ones and turning a
    // denied one into a failed tool result — unless the policy says the run is over.
    //
    // Per call rather than per turn, because that is the granularity approval happens at: a model
    // that asks for `search` and `rm` in one turn should get its search.
    fn gate_calls(calls: List<Part>, conv: Conversation, run_id: string, turn: int, usage: Usage): (Approved, ?Denial, List<Fired>) {
        mut approved: List<Part> = []
        mut canned: List<Part> = []
        mut fired: List<Fired> = []
        if self.guards.len() == 0 {
            return (Approved { approved: calls, canned: canned }, none, fired)
        }
        for c in calls {
            asked = gate(self.guards, Stage.ToolCall, call_ctx(conv, run_id, turn, usage, c))
            fired = fired ~ asked.fired
            match asked.denial {
                some(d) => {
                    match self.config.on_deny {
                        // A denied call is a failed tool turn — "a failing tool is a turn, not an
                        // outage", and a model told it may not use a tool will pick another.
                        OnDeny.Feedback(max) => {
                            canned = canned ~ [refusal_result(c, d.reason)]
                        },
                        OnDeny.Replace(parts) => {
                            canned = canned ~ [refusal_result(c, text_of(parts))]
                        },
                        OnDeny.Stop => {
                            return (Approved { approved: approved, canned: canned }, some(d), fired)
                        },
                    }
                },
                none => {
                    approved = approved ~ asked.parts
                },
            }
        }
        return (Approved { approved: approved, canned: canned }, none, fired)
    }

    // One structured model call, erased over the provider.
    //
    // **The erasure is what makes `extract::<T>` writable at all**, and the reason is measured
    // rather than aesthetic. A generic *method* cannot forward its type parameter into a
    // call-site-typed position — `json.try_parse::<T>` inside one is E0058, "call-site-typed
    // forwarding is supported in top-level generic functions only" — so DESIGN §8.1's
    // `agent.extract::<Extraction>(conv)` cannot exist in any form. A top-level `fn extract<T>` can
    // forward, but a turbofish must supply *every* type parameter (a partial one is E0058), so an
    // `extract<T, P: Provider>` would have to be written `extract::<Extraction, Anthropic>(…)`.
    // Erasing the provider behind this trait leaves exactly one parameter to name, which is the one
    // the caller actually cares about. See §8.1's divergence note.
    impl Structured {
        fn ask_json(conv: Conversation, out: Output): Result<string, AiError> {
            run = drive_sync(self.expecting(out), conv)?
            return structured_json(run, out)
        }
    }

    // The neutral request for a conversation, with the config's system prompt prepended.
    //
    // **This is where the cache breakpoint is placed.** The system prompt arrives already split at
    // its first hole, so the longest provably stable prefix of the request is its stable part, and
    // `prompt_turns` gives that part a turn of its own and marks it. Nothing further along is
    // marked: a conversation's later turns *happen* to repeat inside one run, but the loop cannot
    // promise that of the next run, and a breakpoint spent on a guess is one of four Anthropic
    // allows. A caller who knows better says so with `Message.cached()`.
    //
    // `streamed` is an argument rather than a config read because the two doors disagree on
    // purpose: `stream(conv, out)` streams whatever the config says, and `run_sync` never does.
    fn request(conv: Conversation, streamed: bool = false): ModelRequest {
        mut msgs = conv.messages
        match self.config.system {
            some(sys) => {
                msgs = prompt_turns(Role.System, sys, self.config.cache) ~ msgs
            },
            none => {},
        }
        return ModelRequest {
            model: self.config.model,
            messages: msgs,
            tools: self.toolbox.specs(),
            output: self.output,
            max_tokens: self.config.max_tokens,
            temperature: self.config.temperature,
            stop: self.config.stop,
            extra: self.config.extra,
            stream: streamed,
        }
    }

    // One model call: encode, read the answer, emit its events, fold the deltas into a reply — with
    // the `chat {model}` span and the two GenAI metrics around it. The only I/O in the package.
    async fn call(req: ModelRequest, sink: dyn EventSink): Result<ModelReply, AiError> {
        wire = self.provider.encode(req)?
        vendor = self.provider.name()

        span = tracing.span("chat ${req.model}")
        span.set_attribute("gen_ai.operation.name", "chat")
        span.set_attribute("gen_ai.provider.name", vendor)
        span.set_attribute("gen_ai.request.model", req.model)
        match req.max_tokens {
            some(n) => {
                span.set_attribute("gen_ai.request.max_tokens", n)
            },
            none => {},
        }
        match req.temperature {
            some(t) => {
                span.set_attribute("gen_ai.request.temperature", t)
            },
            none => {},
        }
        if capture_messages() {
            span.add_event("gen_ai.client.inference.operation.details")
            span.set_attribute("gen_ai.input.messages", wire.body)
        }

        started = time.monotonic()
        outcome: Result<ModelReply, AiError> = self.answer(wire, sink).await
        elapsed = (time.monotonic() - started).to_float() / 1000.0

        mut attrs = {
            "gen_ai.operation.name": "chat",
            "gen_ai.provider.name": vendor,
            "gen_ai.request.model": req.model,
        }
        match outcome {
            Ok(reply) => {
                span.set_attribute("gen_ai.response.model", reply.model)
                span.set_attribute("gen_ai.response.finish_reasons", reply.stop.semconv())
                span.set_attribute("gen_ai.usage.input_tokens", reply.usage.input_tokens)
                span.set_attribute("gen_ai.usage.output_tokens", reply.usage.output_tokens)
                // The prompt cache's answer, and the only way to find out whether a breakpoint did
                // anything. Set **only when a vendor reported a read**: `Usage.cached_input_tokens`
                // is `0` both for "the cache missed" and for "this vendor does not report it", so
                // an unconditional `0` would claim a miss we cannot distinguish from silence. The
                // attribute's presence therefore means "the vendor served this many input tokens
                // from its cache".
                if reply.usage.cached_input_tokens > 0 {
                    span.set_attribute("gen_ai.usage.cached_input_tokens", reply.usage.cached_input_tokens)
                }
                if capture_messages() {
                    span.set_attribute("gen_ai.output.messages", "${reply.parts}")
                }
                record_tokens(vendor, req.model, reply.usage)
            },
            Err(e) => {
                span.record_error("${e}")
                attrs = attrs.set("error.type", error_type(e))
            },
        }
        operation_duration_histogram().record_with(elapsed, attrs)
        span.end()
        return outcome
    }

    // The transport half of `call`, kept apart so the span above wraps exactly the request and
    // nothing else.
    //
    // **This `if` is the only place in the package that knows there are two transports.** Below it
    // both branches produce a `List<Delta>`, and everything after that — the event emission, the
    // accumulation into a `ModelReply`, the tool loop, the telemetry — is one implementation. A bug
    // in "these increments make that message" therefore cannot exist in only one of them.
    async fn answer(wire: Wire, sink: dyn EventSink): Result<ModelReply, AiError> {
        if wire.streamed() {
            return Ok(fold(self.streamed_deltas(wire, sink).await?, ""))
        }
        return Ok(fold(self.buffered_deltas(wire, sink).await?, ""))
    }

    // The buffered read: one request through the `para/api` chain, one whole body, one decode. The
    // deltas all exist at once, so all the events do too.
    async fn buffered_deltas(wire: Wire, sink: dyn EventSink): Result<List<Delta>, AiError> {
        req: Request = self.api.prepare(wire.method, wire.url, wire.body, wire.headers)
        // `?` here is the `impl From<HttpError>` conversion: a transport failure — and only a
        // transport failure — is an `Err` out of `send`. An HTTP error *status* arrives as `Ok`.
        resp = self.api.send(req)?
        if !resp.ok() {
            return Err(self.provider.decode_error(resp.status(), resp.body()))
        }
        deltas = self.provider.decode_deltas(resp.body())?
        for e in events_of(deltas) {
            sink.emit(e).await
        }
        return Ok(deltas)
    }

    // The framed read: open the body, push each frame through the provider's own decoder, and emit
    // as the deltas arrive rather than once they all have.
    //
    // The read loop never leaves early. A decode failure is remembered and ends the loop, so that
    // `close()` runs and the open block is closed on the way out whatever happened — an event
    // stream that stops with a `TextStart` unmatched is one a renderer cannot recover from.
    async fn streamed_deltas(wire: Wire, sink: dyn EventSink): Result<List<Delta>, AiError> {
        req: Request = self.api.prepare(wire.method, wire.url, wire.body, wire.headers)
        frames = self.open_frames(req, wire.ndjson()).await?
        decoder = self.provider.decoder()
        mut all: List<Delta> = []
        mut open = Open {}
        mut failure: ?AiError = none
        mut reading = true
        while reading {
            arrived = frames.next().await
            match arrived {
                some(f) => {
                    match decoder.push(f) {
                        Ok(more) => {
                            all = all ~ more
                            open = emit_steps(open, more, sink).await
                        },
                        Err(e) => {
                            failure = some(e)
                            reading = false
                        },
                    }
                },
                none => {
                    reading = false
                },
            }
        }
        frames.close()
        for e in closing(open) {
            sink.emit(e).await
        }
        match failure {
            some(e) => {
                return Err(e)
            },
            none => {},
        }
        // `finish` is where a truncated stream is caught — the frames that *did* arrive decode
        // perfectly well, and only the missing terminator says the reply is half of one. It is also
        // where the call's token totals come from: a vendor that splits the input and output counts
        // across two frames has no single frame to read them off.
        usage = decoder.finish()?
        return Ok(all ~ [Delta.UsageDelta(usage: usage)])
    }

    // Open a streamed body, retrying a transport failure or a retryable vendor status.
    //
    // **The streaming path owns its retry** (DESIGN O-4). `para/api`'s `Retry` cannot cover it:
    // retrying means calling `next` again, a second call means a second body, and a stream you have
    // begun reading cannot be asked twice. So the backoff is here, bounded by
    // `AgentConfig.stream_retries`, and the README states which layers cover which path rather than
    // implying blanket coverage.
    async fn open_frames(req: Request, ndjson: bool): Result<dyn Frames, AiError> {
        framing = if ndjson then Framing.Ndjson else Framing.Sse
        budget = at_least(self.config.stream_retries, 0)
        mut attempt = 0
        mut wait = at_least(self.config.stream_backoff_ms, 1)
        mut last = AiError.Cancelled
        while attempt <= budget {
            match self.transport.open(req, framing) {
                Ok(opened) => {
                    return Ok(opened)
                },
                Err(e) => {
                    last = e
                },
            }
            if !retryable(last) {
                return Err(last)
            }
            attempt = attempt + 1
            if attempt <= budget {
                sleep(wait).await
                wait = wait * 2
            }
        }
        return Err(last)
    }

    // Run a conversation, emitting every event into `out` as it happens.
    //
    // **Streams whatever `AgentConfig.stream` says.** A caller who asked for events as they happen
    // has said what they want, and delivering them all at the end because a flag was off would be a
    // lie about what a `Sender<Event>` means. Open the channel and `spawn` this:
    //
    //     (tx, rx) = channel::<Event>(16)
    //     concurrent {
    //         spawn render(rx)
    //         run = agent.stream(conv, tx).await?
    //     }
    //
    // `thread_id` and `run_id` are the two identifiers a *protocol* supplies rather than the loop:
    // AG-UI's `RunAgentInput` carries both, and a client correlates the stream it is reading with
    // the `runId` it sent. Both default to `""`, which means "the loop decides" — an empty thread
    // id stays empty, and an empty run id becomes a fresh uuid, exactly as before. See
    // `para.ai.agui.respond`, which is the caller that passes them.
    async fn stream(conv: Conversation, out: Sender<Event>, thread_id: string = "", run_id: string = ""): Result<Run, AiError> {
        return self.drive(conv, Channel { tx: out }, true, thread_id, run_id).await
    }

    // Run a conversation, handing every event to a sink of your own.
    //
    // The door for a consumer that does not need a channel: a CLI renderer that writes to the
    // terminal as tokens arrive, and `para.ai.mock.Collector`, which is how asserting on a run's
    // exact event sequence is a `@test` block with no server and no socket. Unlike `stream`, this
    // follows `AgentConfig.stream` — a synchronous renderer over a buffered call is a legitimate
    // thing to want, and it gets the identical events.
    async fn run_into(conv: Conversation, sink: dyn EventSink): Result<Run, AiError> {
        return self.drive(conv, sink, self.config.stream).await
    }

    // Run a conversation to an answer.
    //
    // The same run as `stream`, with the events dropped instead of sent — one loop, one delta
    // vocabulary, one accumulator, one emitter, and the sink as the only difference. Whether the
    // model call is streamed follows `AgentConfig.stream`, which is off by default because the
    // buffered transport is the one the `para/api` layers cover (DESIGN O-4).
    async fn run(conv: Conversation): Result<Run, AiError> {
        return self.drive(conv, Silent {}, self.config.stream).await
    }

    // The string-in / string-out door.
    //
    // Deliberate, and the same idea as para/aether's `app.handle(method, path, body)`: a plain
    // string entry point is what makes a framework testable in a `@test` block. It stays
    // synchronous so it is callable from anywhere, including a plain `fn` — see `drive_sync` for
    // how a synchronous door drives an asynchronous loop without a second copy of the loop.
    fn run_sync(text: string): Result<string, AiError> {
        run = drive_sync(self, Conversation.of(text))?
        return Ok(run.text())
    }

    // The run loop.
    //
    // Its shape is DESIGN §5's, with two of the steps still to come: this is where the guard stages
    // and the context strategy attach in phase 5.
    //
    // A run emits **exactly one** terminal event, `RunFinished` or `RunError`, on every path out —
    // including the failing ones. AG-UI requires it and a renderer needs it: a stream that merely
    // stops is indistinguishable from one still thinking.
    //
    // `thread_id` and `run_id` come from the protocol the run is being served over, when there is
    // one — `para.ai.agui.respond` reads both off AG-UI's `RunAgentInput` and passes them here, so
    // the stream a client reads carries the identifiers that client sent. Both default to `""`,
    // which is what every other door passes: an empty thread id stays empty rather than being
    // invented, and an empty run id becomes a fresh uuid. The run id is also the span's
    // `para.ai.run.id`, so a client-supplied one correlates a trace with the caller's own record.
    async fn drive(conv: Conversation, sink: dyn EventSink, streamed: bool, thread_id: string = "", run_id: string = ""): Result<Run, AiError> {
        id = if run_id == "" then "${uuid()}" else run_id
        root = tracing.span("invoke_agent ${self.config.name}")
        root.set_attribute("gen_ai.operation.name", "invoke_agent")
        root.set_attribute("gen_ai.agent.name", self.config.name)
        root.set_attribute("gen_ai.provider.name", self.provider.name())
        root.set_attribute("gen_ai.request.model", self.config.model)
        root.set_attribute("para.ai.run.id", id)

        sink.emit(Event.RunStarted(run_id: id, thread_id: thread_id)).await
        outcome: Result<Run, AiError> = self.turns(conv, sink, streamed, id).await
        match outcome {
            Ok(run) => {
                root.set_attribute("gen_ai.usage.input_tokens", run.usage.input_tokens)
                root.set_attribute("gen_ai.usage.output_tokens", run.usage.output_tokens)
                // Aggregated over the run's calls — see `call` for why it is conditional.
                if run.usage.cached_input_tokens > 0 {
                    root.set_attribute("gen_ai.usage.cached_input_tokens", run.usage.cached_input_tokens)
                }
                root.set_attribute("gen_ai.response.finish_reasons", run.stop.semconv())
                root.set_attribute("para.ai.run.turns", run.turns)
                root.end()
                sink.emit(Event.RunFinished(run_id: id, usage: run.usage)).await
            },
            Err(e) => {
                root.record_error("${e}")
                root.end()
                // A failure is a frame, not a dropped connection. `code` is the error's class, the
                // same low-cardinality string the metrics use, so a consumer can branch on it.
                sink.emit(Event.RunError(message: "${e}", code: error_type(e))).await
            },
        }
        return outcome
    }

    // Call, and keep calling while the model asks for tools.
    //
    // The shape, in full:
    //
    //   1. encode the conversation and send it (`call`, which owns the `chat {model}` span)
    //   2. a refusal is `AiError.Refused`, immediately — never a decode failure, never a retry
    //   3. append the assistant turn
    //   4. if the model did not ask for a tool, finish
    //   5. dispatch the requested calls concurrently and bounded, append **one** tool turn
    //      carrying every result, and go round again
    //
    // Two details in step 5 are decisions rather than convenience:
    //
    //   * **One turn, all the results.** A separate message per result would produce consecutive
    //     same-role turns, which several vendors reject outright — and it would make it possible
    //     for a context strategy to split a `ToolCall` from its `ToolResult`, the single most
    //     common bug in hand-rolled trimming (DESIGN §10). Keeping them in one message makes that
    //     unrepresentable.
    //   * **A tool-use stop with nothing to dispatch finishes the run**, rather than looping. An
    //     agent with no toolbox, or a model naming a tool in a reply that carries no call block,
    //     hands the requested calls back in `Run.messages` — which is exactly what phase 1 did, and
    //     the only behavior that cannot spin.
    // The four guard stages hang off this loop, one at each point where content crosses a boundary
    // (DESIGN §9): `Input` once on the trailing user turn, `Output` on each reply, `ToolCall` on
    // each requested call before dispatch, and `ToolResult` on what dispatch produced. A run with no
    // guards registered takes the same path it always did — `gate` is not even consulted.
    async fn turns(conv: Conversation, sink: dyn EventSink, streamed: bool, run_id: string): Result<Run, AiError> {
        mut so_far = conv
        mut usage = Usage {}
        mut turn = 0
        mut fired: List<Fired> = []
        mut corrections = 0

        // **`Input` runs once, not once per turn.** The stage is about what the *user* sent, and a
        // tool loop's later turns are the model talking to itself — re-running `Recall` on each of
        // them would prepend the same memories four times and re-running `Blocklist` would judge
        // text the user never wrote.
        if self.guards.len() > 0 {
            entry = gate(self.guards, Stage.Input, input_ctx(so_far, run_id))
            fired = fired ~ entry.fired
            match entry.denial {
                some(d) => {
                    // Nothing has been sent, so there is nobody to give feedback to: `Feedback`
                    // degenerates to `Stop` here, and `Replace` is the policy with a real answer —
                    // the canned "I can't help with that" every product ships.
                    return input_denied(self.config.on_deny, so_far, d, fired, turn)
                },
                none => {
                    so_far = with_rewritten_tail(so_far, Role.User, entry.parts)
                },
            }
        }

        while turn < self.config.max_turns {
            reply = self.call(self.request(so_far, streamed), sink).await?
            turn = turn + 1
            usage = usage + reply.usage
            if reply.stop == StopReason.Refusal {
                return Err(AiError.Refused(reason: refusal_text(reply)))
            }

            mut parts = reply.parts
            // Named `feedback` rather than `correction`: the module-level `correction(e)` builds the
            // *structured-output* repair turn, and a local of that name shadows it (E0007 at the
            // first use, which is a confusing place to read about a name collision).
            mut feedback = ""
            if self.guards.len() > 0 {
                judged = gate(self.guards, Stage.Output, turn_ctx(Stage.Output, so_far, run_id, turn, usage, parts))
                fired = fired ~ judged.fired
                match judged.denial {
                    some(d) => {
                        match self.config.on_deny {
                            OnDeny.Feedback(max) => {
                                if corrections >= max {
                                    return Err(guard_error(d))
                                }
                                corrections = corrections + 1
                                feedback = d.reason
                            },
                            OnDeny.Replace(canned) => {
                                return Ok(Run {
                                    messages: so_far.with(Message { role: Role.Assistant, parts: canned }).messages,
                                    usage: usage,
                                    turns: turn,
                                    stop: reply.stop,
                                    verdicts: fired,
                                })
                            },
                            OnDeny.Stop => {
                                return Err(guard_error(d))
                            },
                        }
                    },
                    none => {
                        parts = judged.parts
                    },
                }
            }

            so_far = so_far.with(Message { role: Role.Assistant, parts: parts })

            // A denied answer that is being fed back: the reason becomes a user turn and the model
            // tries again. Written as an `if`/`else` rather than a `continue` — the run loop keeps a
            // `mut` accumulator per iteration, and an early-exit edge over one of those is the shape
            // AGENTS.md records as a live workaround in `encode_messages`.
            if feedback != "" {
                so_far = so_far.user(feedback)
            } else {
                // **The output tool is an answer, not a call.** Anthropic has no `response_format`,
                // so a structured request goes out as a forced tool and the document comes back as a
                // `tool_use` block with `stop_reason: tool_use` — indistinguishable, at this point,
                // from the model asking for a real tool. Dispatching it would look up a tool no
                // `ToolSource` declares, feed the model "unknown tool", and spin the loop for a
                // reply that already arrived. Withholding it here finishes the run with the document
                // in `Run.messages`, where `structured_json` reads it.
                calls = dispatchable_calls(tool_calls_of(parts), self.output)
                if reply.stop != StopReason.ToolUse || calls.len() == 0 || self.toolbox.is_empty() {
                    return Ok(Run {
                        messages: so_far.messages,
                        usage: usage,
                        turns: turn,
                        stop: reply.stop,
                        verdicts: fired,
                    })
                }
                // **`ToolCall` sits above `Toolbox.call`, which is what makes one mechanism cover
                // local and MCP tools alike** (DESIGN §7.1). By the time a call reaches here it is an
                // ordinary tool call whatever source declared it, so `Approval` needed no MCP hook.
                (allowed, refused, call_fired) = self.gate_calls(calls, so_far, run_id, turn, usage)
                fired = fired ~ call_fired
                match refused {
                    some(d) => {
                        return Err(guard_error(d))
                    },
                    none => {},
                }
                dispatched = tools.dispatch(self.toolbox, allowed.approved, self.config.tool_concurrency)
                // Back in the order the model asked, not "every refusal, then every answer" — see
                // `in_call_order`. A guard splitting the turn must not reorder it.
                mut results = in_call_order(calls, allowed.canned ~ dispatched)
                if self.guards.len() > 0 {
                    seen = gate(self.guards, Stage.ToolResult, turn_ctx(Stage.ToolResult, so_far, run_id, turn, usage, results))
                    fired = fired ~ seen.fired
                    match seen.denial {
                        some(d) => {
                            match self.config.on_deny {
                                // A denied result is a failed tool turn, which is exactly the shape
                                // the model already knows how to recover from.
                                OnDeny.Feedback(max) => {
                                    results = errored(results, d.reason)
                                },
                                OnDeny.Replace(canned) => {
                                    results = errored(results, text_of(canned))
                                },
                                OnDeny.Stop => {
                                    return Err(guard_error(d))
                                },
                            }
                        },
                        none => {
                            results = seen.parts
                        },
                    }
                }
                emit_results(results, sink).await
                so_far = so_far.with(Message { role: Role.Tool, parts: results })
            }
        }
        return Err(AiError.MaxTurns(turns: self.config.max_turns))
    }
}

// --- Driving the loop -----------------------------------------------------------------------------

// Push a chunk of deltas through the emitter, returning the block state that follows them.
//
// The streaming path calls this once per frame and the buffered path once per body, over the same
// `step` — which is exactly why the two produce the same event sequence for the same deltas.
async fn emit_steps(open: Open, deltas: List<Delta>, sink: dyn EventSink): Open {
    mut cur = open
    for d in deltas {
        (next, evs) = step(cur, d)
        cur = next
        for e in evs {
            sink.emit(e).await
        }
    }
    return cur
}

// One `ToolCallResult` per dispatched call, in call order. A non-result part cannot appear here —
// `dispatch` is total on that — but ignoring one rather than asserting keeps this a reporting step.
async fn emit_results(results: List<Part>, sink: dyn EventSink): void {
    for p in results {
        match p {
            Part.ToolResult(id, content, is_error) => {
                sink.emit(Event.ToolCallResult(id: id, content: content, is_error: is_error)).await
            },
            _ => {},
        }
    }
}

// One run, packaged so `map_bounded` can drive it — the same shape `tools.dispatch` uses, and for
// the same reason: the combinator takes a plain async function, so everything the call needs
// travels in the item.
struct RunJob<P: Provider> {
    agent: Agent<P>
    conv: Conversation
}

async fn run_job<P: Provider>(j: RunJob<P>): Result<Run, AiError> {
    return j.agent.drive(j.conv, Silent {}, j.agent.config.stream).await
}

// Drive the run loop to completion from synchronous code.
//
// `run_sync` is the string-in / string-out door, and it has to stay callable from a plain `fn` —
// while the loop itself is `async`, because streaming genuinely is. `std.task.map_bounded` bridges
// the two: it drives a list of futures to completion and hands back their results, so for a
// one-element list it is precisely "run this future here and give me the answer". Spelling that as
// a concurrency combinator rather than as a `block_on` is a std gap, not a design choice — and the
// alternative was a second, synchronous copy of the run loop, which is where the bugs would live.
//
// **Public**, because it is the synchronous door onto a whole `Run` and there is no other:
// `run_sync` flattens the answer to a string, so a caller who wants the usage, the turn count or
// `Run.verdicts` from synchronous code has nowhere else to go. `Structured.ask_json` is the first
// caller inside this package to need exactly that.
pub fn drive_sync<P: Provider>(agent: Agent<P>, conv: Conversation): Result<Run, AiError> {
    return map_bounded([RunJob { agent: agent, conv: conv }], 1, run_job)[0]
}

// Which failures a streamed call tries again.
//
// Deliberately narrow: a transport failure, and the vendor statuses that mean "later", not "never".
// A 400 retried is a 400 twice, and a 401 retried is a wasted second of someone's rate limit.
fn retryable(e: AiError): bool {
    return match e {
        AiError.Transport(inner) => true,
        AiError.Provider(status, code, message) => status == 429 || status == 500 || status == 502
            || status == 503 || status == 504 || status == 529,
        _ => false,
    }
}

fn at_least(n: int, floor: int): int {
    return if n < floor then floor else n
}

// The `ToolCall` parts of an assistant turn, in order.
fn tool_calls_of(parts: List<Part>): List<Part> {
    mut out: List<Part> = []
    for p in parts {
        match p {
            Part.ToolCall(id, name, args) => {
                out = out ~ [p]
            },
            _ => {},
        }
    }
    return out
}

// Record one call's token usage on `gen_ai.client.token.usage`, split by token type — the shape
// the GenAI convention specifies, and the reason it is a histogram rather than a counter (the
// distribution of prompt sizes is the interesting part).
fn record_tokens(vendor: string, model: string, usage: Usage): void {
    h = token_usage_histogram()
    base = {"gen_ai.operation.name": "chat", "gen_ai.provider.name": vendor, "gen_ai.request.model": model}
    h.record_with(usage.input_tokens.to_float(), base.set("gen_ai.token.type", "input"))
    h.record_with(usage.output_tokens.to_float(), base.set("gen_ai.token.type", "output"))
}

// The `error.type` metric attribute: the error's *class*, never its message. A message is
// unbounded-cardinality and would turn one histogram into thousands of series.
fn error_type(e: AiError): string {
    return match e {
        AiError.Transport(inner) => inner.kind(),
        AiError.Provider(status, code, message) => if code == "" then "${status}" else code,
        AiError.Encode(p, m) => "encode",
        AiError.Decode(path, m) => "decode",
        AiError.Refused(reason) => "refusal",
        AiError.Tool(name, m) => "tool",
        // The code is one of a fixed set, so it stays low-cardinality — and "the server exited"
        // and "the server broke the protocol" are different operational problems.
        AiError.Mcp(server, code, m) => if code == "" then "mcp" else "mcp_${code}",
        AiError.MaxTurns(turns) => "max_turns",
        AiError.ContextOverflow(needed, budget) => "context_overflow",
        // The class, not the guard's name: a guard is an ordinary value and a caller may register
        // as many as they like, so the *name* is unbounded and belongs in the span event (which
        // carries it) rather than in a metric attribute.
        AiError.Guard(stage, guard, reason) => "guard",
        AiError.Cancelled => "cancelled",
    }
}

// What a refusing model said, when it said anything. Vendors differ on whether a refusal carries
// prose; an empty reason is reported as such rather than as a blank string.
fn refusal_text(reply: ModelReply): string {
    mut out = ""
    for p in reply.parts {
        out = out ~ match p {
            Part.Text(t) => t,
            _ => "",
        }
    }
    return if out == "" then "no reason given" else out
}

@test {
    fn a_message_reads_back_its_text_parts(): void {
        m = Message {
            role: Role.Assistant,
            parts: [
                Part.Thinking(text: "hidden", signature: "s"),
                Part.Text(text: "Hej"),
                Part.Text(text: " då"),
            ],
        }
        // Thinking is not what the message said.
        assert(m.text() == "Hej då")
    }

    fn a_message_reports_the_tool_calls_it_requests(): void {
        m = Message {
            role: Role.Assistant,
            parts: [
                Part.Text(text: "let me look"),
                Part.ToolCall(id: "a", name: "weather", args: "{}"),
                Part.ToolCall(id: "b", name: "clock", args: "{}"),
            ],
        }
        assert(m.tool_calls().len() == 2)
        assert(Message.user("hi").tool_calls() == [])
    }

    // **A guard splits a tool turn, and the split must not reorder it.** `gate_calls` sorts the
    // requested calls into the approved ones (which go to `dispatch` and come back in *their* order)
    // and the denied ones (answered on the spot), so concatenating the two lists put every refusal in
    // front of every answer — a model that asked for `find` and then `write` was handed the refusal
    // first. `dispatch` preserves per-item order on purpose; a guard must not be what undoes it.
    fn a_split_tool_turn_comes_back_in_the_order_the_model_asked(): void {
        calls = [
            Part.ToolCall(id: "a", name: "find", args: "{}"),
            Part.ToolCall(id: "b", name: "write", args: "{}"),
            Part.ToolCall(id: "c", name: "find", args: "{}"),
        ]
        // What the loop holds at the merge: the denied one first (answered without dispatching),
        // then the dispatched ones in their own order.
        results = [
            Part.ToolResult(id: "b", content: "denied", is_error: true),
            Part.ToolResult(id: "a", content: "one", is_error: false),
            Part.ToolResult(id: "c", content: "three", is_error: false),
        ]
        ordered = in_call_order(calls, results)
        assert(ordered.map(fn(p) => result_id(p)) == ["a", "b", "c"], "${ordered}")

        // Nothing is dropped, even a result whose call is not in the list — a lost result is a call
        // the model never hears back about, which several vendors reject the whole request for.
        stray = in_call_order(calls, results ~ [Part.ToolResult(id: "z", content: "?", is_error: false)])
        assert(stray.len() == 4, "${stray}")
        assert(result_id(stray[3]) == "z", "an unmatched result is appended, not dropped: ${stray}")
    }

    fn conversation_builders_are_immutable(): void {
        base = Conversation.of("one")
        grown = base.user("two")
        assert(base.messages.len() == 1, "the original is untouched")
        assert(grown.messages.len() == 2)
        assert(grown.messages[1].text() == "two")
    }

    // The split becomes two turns of one role, with the breakpoint on the stable one. Everything
    // downstream — the `cache_control` marker, the byte-identical prefix — reads off this shape.
    fn a_split_prompt_becomes_a_marked_stable_turn_and_a_volatile_one(): void {
        r = Resolved { statics: ["You work for ", ". Be brief."], holes: ["Acme"] }
        turns = prompt_turns(Role.System, r, true)
        assert(turns.len() == 2, "${turns}")
        assert(turns[0] == Message {
            role: Role.System,
            parts: [Part.Text(text: "You work for ")],
            cache_breakpoint: true,
        }, "${turns[0]}")
        assert(turns[1] == Message {
            role: Role.System,
            parts: [Part.Text(text: "Acme. Be brief.")],
        }, "${turns[1]}")
        // The two turns still say exactly what the prompt said, in order.
        assert(turns[0].text() ~ turns[1].text() == r.text())
    }

    // No holes is the best case, not the empty one: the whole prompt is the prefix, in one turn.
    fn a_static_prompt_becomes_one_marked_turn(): void {
        turns = prompt_turns(Role.System, Resolved.of("Answer in one sentence."), true)
        assert(turns.len() == 1, "${turns}")
        assert(turns[0].cache_breakpoint, "a static prompt is stable in its entirety")
        assert(turns[0].text() == "Answer in one sentence.")
    }

    // Nothing in front of the first hole means nothing to cache — and marking an empty content
    // block is a vendor error, not a free win. One unmarked turn.
    fn a_prompt_with_no_stable_prefix_is_one_unmarked_turn(): void {
        r = Resolved { statics: [" ", " is asking."], holes: ["Ada"] }
        turns = prompt_turns(Role.User, r, true)
        assert(turns.len() == 1, "${turns}")
        assert(turns[0].cache_breakpoint == false, "whitespace is not a cache prefix")
        assert(turns[0].text() == " Ada is asking.", "[${turns[0].text()}]")
    }

    // `mark: false` changes the marker and nothing else — the stable text is still first and still
    // byte-identical, which is all an implicitly-caching vendor needs.
    fn declining_to_mark_leaves_the_split_alone(): void {
        r = Resolved { statics: ["stable ", " tail"], holes: ["x"] }
        marked = prompt_turns(Role.System, r, true)
        plain = prompt_turns(Role.System, r, false)
        assert(marked.len() == plain.len())
        assert(marked[0].parts == plain[0].parts, "the same bytes either way")
        assert(marked[0].cache_breakpoint && plain[0].cache_breakpoint == false)
    }

    // A `Prompt` enters a conversation as naturally as a string does, and resolves once on the way
    // in — a `Conversation` is a value, and a list of thunks is not one.
    fn a_conversation_accepts_a_prompt_like_a_string(): void {
        p = Prompt { statics: ["Context: ", "\nAnswer briefly."], holes: [fn() => "the manual"] }
        conv = Conversation.new().system_prompt(p).user("what is it?")
        assert(conv.messages.len() == 3, "${conv.messages}")
        assert(conv.messages[0].role == Role.System)
        assert(conv.messages[0].text() == "Context: ")
        assert(conv.messages[1].text() == "the manual\nAnswer briefly.")
        assert(conv.messages[2].text() == "what is it?")
        // A conversation turn is not reliably a prefix, so it is unmarked unless asked.
        assert(conv.messages[0].cache_breakpoint == false, "a conversation turn is unmarked by default")
        assert(Conversation.new().system_prompt(p, true).messages[0].cache_breakpoint)
        assert(Conversation.new().user_prompt(p).messages[0].role == Role.User)
    }

    // The hand door, for a long stable turn the caller knows repeats and the loop cannot.
    fn a_message_can_be_marked_by_hand(): void {
        m = Message.user("a very long retrieved corpus").cached()
        assert(m.cache_breakpoint)
        assert(Message.user("a very long retrieved corpus").cache_breakpoint == false)
        assert(m.parts == Message.user("a very long retrieved corpus").parts, "only the marker differs")
    }

    fn a_tool_message_addresses_the_call_it_answers(): void {
        m = Message.tool("call_7", "18°C", true)
        assert(m.role == Role.Tool)
        assert(m.parts == [Part.ToolResult(id: "call_7", content: "18°C", is_error: true)])
        // The flag defaults to a successful result.
        assert(Message.tool("call_7", "ok").parts == [Part.ToolResult(id: "call_7", content: "ok", is_error: false)])
    }

    fn config_builders_return_new_values(): void {
        base = AgentConfig.new("m")
        tuned = base.with_system("be brief").with_max_tokens(64).with_temperature(0.0).named("brief")
        assert(base.system == none, "the original is untouched")
        // A plain string is a prompt with no holes, so it arrives as one static and is stable in
        // its entirety — the maximal cache prefix.
        assert(tuned.system == some(Resolved.of("be brief")), "${tuned.system}")
        assert(tuned.system_text() == some("be brief"))
        assert(tuned.max_tokens == some(64))
        assert(tuned.temperature == some(0.0))
        assert(tuned.name == "brief")
        assert(tuned.model == "m")
    }

    // The two loop bounds have defaults a caller never has to think about, and both are reachable
    // when they do. Unbounded is not an option for either: a runaway tool loop spends money, and
    // unbounded parallel dispatch is a good way to get rate-limited by your own agent.
    fn the_loop_bounds_have_defaults_and_builders(): void {
        base = AgentConfig.new("m")
        assert(base.max_turns == 8)
        assert(base.tool_concurrency == 4)
        tuned = base.with_max_turns(2).with_tool_concurrency(1)
        assert(base.max_turns == 8, "the original is untouched")
        assert(tuned.max_turns == 2)
        assert(tuned.tool_concurrency == 1)
    }

    // Streaming is off by default and both directions are one builder call, because turning it on
    // trades the `para/api` layers away (DESIGN O-4) and that should be a thing you wrote down.
    fn streaming_is_opt_in_and_reversible(): void {
        base = AgentConfig.new("m")
        assert(!base.stream, "the covered path is the default")
        assert(base.stream_retries == 2, "the same shape para/api's Retry defaults to")
        assert(base.stream_backoff_ms == 500)
        on = base.streamed().with_stream_retries(5).with_stream_backoff(20)
        assert(!base.stream, "the original is untouched")
        assert(on.stream)
        assert(on.stream_retries == 5)
        assert(on.stream_backoff_ms == 20)
        assert(!on.buffered().stream, "and back again")
    }

    // Only the retryable statuses, and a transport failure. A 400 retried is a 400 twice.
    fn only_a_later_not_a_never_is_retried(): void {
        assert(retryable(AiError.Provider(status: 429, code: "rate_limit_error", message: "")))
        assert(retryable(AiError.Provider(status: 503, code: "overloaded_error", message: "")))
        assert(retryable(AiError.Provider(status: 529, code: "overloaded_error", message: "")))
        assert(!retryable(AiError.Provider(status: 400, code: "invalid_request_error", message: "")))
        assert(!retryable(AiError.Provider(status: 401, code: "authentication_error", message: "")))
        assert(!retryable(AiError.Refused(reason: "policy")))
        assert(!retryable(AiError.MaxTurns(turns: 8)))
    }

    // --- The event emitter ------------------------------------------------------------------------
    //
    // Pure, so it can be tested without a run at all — and it is the single reason a buffered run
    // and a streamed run of the same reply produce the same events.

    fn a_block_opens_once_and_closes_once(): void {
        assert(events_of([
            Delta.TextDelta(id: "0", text: "Hel"),
            Delta.TextDelta(id: "0", text: "lo"),
        ]) == [
            Event.TextStart(id: "0"),
            Event.TextDelta(id: "0", delta: "Hel"),
            Event.TextDelta(id: "0", delta: "lo"),
            Event.TextEnd(id: "0"),
        ])
    }

    // A change of id closes the old block before opening the new one, so a consumer never has two
    // open at once.
    fn a_new_block_closes_the_previous_one(): void {
        assert(events_of([
            Delta.TextDelta(id: "0", text: "a"),
            Delta.ToolCallStart(id: "t1", name: "weather"),
            Delta.ToolCallArgs(id: "t1", fragment: "{}"),
        ]) == [
            Event.TextStart(id: "0"),
            Event.TextDelta(id: "0", delta: "a"),
            Event.TextEnd(id: "0"),
            Event.ToolCallStart(id: "t1", name: "weather"),
            Event.ToolCallArgsDelta(id: "t1", delta: "{}"),
            Event.ToolCallEnd(id: "t1"),
        ])
    }

    // Thinking has a delta and nothing else in the vocabulary — no start, no end — so its block
    // opens and closes silently. The signature is state, not something a consumer renders.
    fn thinking_has_a_delta_and_no_brackets(): void {
        assert(events_of([
            Delta.ThinkingDelta(id: "0", text: "hm"),
            Delta.ThinkingSignature(id: "0", signature: "sig"),
        ]) == [Event.ThinkingDelta(id: "0", delta: "hm")])
    }

    // The result deltas are the run's outcome rather than increments of a block, and they surface
    // in the terminal event instead.
    fn stop_usage_and_model_produce_no_events(): void {
        assert(events_of([
            Delta.ModelDelta(model: "claude-opus-5"),
            Delta.Stop(reason: StopReason.EndTurn),
            Delta.UsageDelta(usage: Usage { input_tokens: 1 }),
        ]) == [])
    }

    // A run that never finished is not an answer. The message names the knob rather than leaving a
    // reader to find it.
    fn exhausting_the_turn_budget_is_its_own_error(): void {
        e = AiError.MaxTurns(turns: 8)
        assert("${e}".contains("8-turn limit"), "${e}")
        assert("${e}".contains("max_turns"), "${e}")
        assert(error_type(e) == "max_turns")
    }

    // The unnamed form is the fallback for a failure that belongs to no particular tool.
    fn a_tool_error_reads_correctly_with_and_without_a_name(): void {
        assert("${AiError.Tool(name: "weather", message: "no such city")}"
            == "tool `weather` failed: no such city")
        assert("${AiError.Tool(name: "", message: "no such city")}" == "tool call failed: no such city")
    }

    fn errors_render_their_own_sentence(): void {
        assert("${AiError.Provider(status: 429, code: "rate_limit_error", message: "slow down")}"
            == "provider error 429 rate_limit_error: slow down")
        assert("${AiError.Decode(path: "content[0].text", message: "expected a string")}"
            == "decode failed at content[0].text: expected a string")
        assert("${AiError.Decode(path: "", message: "boom")}" == "decode failed: boom")
        assert("${AiError.Refused(reason: "policy")}" == "the model refused: policy")
        assert("${AiError.Encode(provider: "anthropic", message: "no video")}"
            == "anthropic cannot encode this request: no video")
        // `@derive(Error)` routes `message()` through `Display`, so the two can never disagree.
        assert(AiError.Cancelled.message() == "cancelled")
    }

    // `error.type` is a metric attribute, so it must be the error's class and never its message —
    // one histogram, not one series per failure string.
    fn error_type_is_low_cardinality(): void {
        assert(error_type(AiError.Provider(status: 429, code: "rate_limit_error", message: "x")) == "rate_limit_error")
        // A vendor that sends no code falls back to the status, not to the message.
        assert(error_type(AiError.Provider(status: 503, code: "", message: "upstream said no")) == "503")
        assert(error_type(AiError.Decode(path: "a.b", message: "nope")) == "decode")
        assert(error_type(AiError.Refused(reason: "policy")) == "refusal")
    }

    // The phase-6 variant. A *server* failure, not a tool failure — and it names which server, so a
    // run with two MCP sources attached says which of them stopped answering. The class rides in
    // `code`, drawn from a fixed set, which is what keeps it usable as a metric attribute.
    fn an_mcp_failure_names_the_server_and_its_class(): void {
        assert("${AiError.Mcp(server: "mcp:memory", code: "server_exited", message: "exit status 1")}"
            == "mcp server `mcp:memory` failed (server_exited): exit status 1")
        assert(error_type(AiError.Mcp(server: "mcp:memory", code: "timeout", message: "no reply")) == "mcp_timeout")
        assert(error_type(AiError.Mcp(server: "mcp:memory", code: "", message: "no reply")) == "mcp")
    }

    fn message_capture_is_off_unless_the_standard_env_var_says_otherwise(): void {
        assert(!capture_messages(), "prompts and completions in spans are opt-in")
        env.set("OTEL_GENAI_CAPTURE_MESSAGES", "true")
        assert(capture_messages())
        env.set("OTEL_GENAI_CAPTURE_MESSAGES", "TRUE")
        assert(capture_messages(), "the value is read case-insensitively")
        env.set("OTEL_GENAI_CAPTURE_MESSAGES", "no")
        assert(!capture_messages())
    }
}
